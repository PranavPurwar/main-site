---
interface ScreenshotItem {
	src: string;
	caption?: string;
	alt?: string;
}

interface Props {
	items: ScreenshotItem[];
	id?: string;
}

const { items, id = "carousel" } = Astro.props;
---

{items && items.length > 0 && (
	<figure class="carousel-wrapper" id={id}>
		<div class="carousel-track-container">
			<button class="carousel-btn prev-btn" aria-label="Previous screenshot" type="button">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path fill="currentColor" d="M9.78 12.78a.75.75 0 0 1-1.06 0L4.47 8.53a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 1.06L6.06 8l3.72 3.72a.75.75 0 0 1 0 1.06Z" />
				</svg>
			</button>

			<ul class="carousel-track">
				{items.map((item, index) => (
					<li class={`carousel-slide ${index === 0 ? "active" : ""}`} data-index={index}>
						<img src={item.src} alt={item.alt || item.caption || `Screenshot ${index + 1}`} loading="lazy" />
					</li>
				))}
			</ul>

			<button class="carousel-btn next-btn" aria-label="Next screenshot" type="button">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path fill="currentColor" d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z" />
				</svg>
			</button>
		</div>

		<figcaption class="carousel-caption-row">
			<span class="slide-caption">{items[0]?.caption}</span>
			<span class="carousel-counter">
				<span class="current-index">1</span> / <span class="total-count">{items.length}</span>
			</span>
		</figcaption>

		{items.length > 1 && (
			<div class="carousel-thumbnails">
				{items.map((item, index) => (
					<button
						class={`thumb-btn ${index === 0 ? "active" : ""}`}
						data-thumb={index}
						type="button"
						aria-label={`Go to slide ${index + 1}`}
					>
						<img src={item.src} alt="" aria-hidden="true" />
					</button>
				))}
			</div>
		)}
	</figure>
)}

<script>
	function setupCarousels() {
		const carousels = document.querySelectorAll('.carousel-wrapper');

		carousels.forEach((carousel) => {
			if (carousel.hasAttribute('data-initialized')) return;
			carousel.setAttribute('data-initialized', 'true');

			const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide');
			const thumbs = carousel.querySelectorAll<HTMLElement>('.thumb-btn');
			const prevBtn = carousel.querySelector<HTMLButtonElement>('.prev-btn');
			const nextBtn = carousel.querySelector<HTMLButtonElement>('.next-btn');
			const counter = carousel.querySelector<HTMLElement>('.current-index');
			const captionEl = carousel.querySelector<HTMLElement>('.slide-caption');
			const captions = Array.from(slides).map((s) => {
				const img = s.querySelector('img');
				return img?.getAttribute('alt') || '';
			});
			let currentIndex = 0;
			const total = slides.length;

			if (total === 0) return;

			function updateSlide(newIndex: number) {
				if (newIndex < 0) newIndex = total - 1;
				if (newIndex >= total) newIndex = 0;
				currentIndex = newIndex;

				slides.forEach((s, i) => {
					s.classList.toggle('active', i === currentIndex);
				});

				thumbs.forEach((t, i) => {
					t.classList.toggle('active', i === currentIndex);
					if (i === currentIndex) {
						t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
					}
				});

				if (counter) {
					counter.textContent = String(currentIndex + 1);
				}

				if (captionEl) {
					captionEl.textContent = captions[currentIndex] || '';
				}
			}

			prevBtn?.addEventListener('click', () => updateSlide(currentIndex - 1));
			nextBtn?.addEventListener('click', () => updateSlide(currentIndex + 1));

			thumbs.forEach((thumb, i) => {
				thumb.addEventListener('click', () => updateSlide(i));
			});

			carousel.addEventListener('keydown', (e: Event) => {
				const keyEvent = e as KeyboardEvent;
				if (keyEvent.key === 'ArrowLeft') {
					updateSlide(currentIndex - 1);
				} else if (keyEvent.key === 'ArrowRight') {
					updateSlide(currentIndex + 1);
				}
			});
		});
	}

	setupCarousels();
	document.addEventListener('astro:page-load', setupCarousels);
</script>

<style>
	.carousel-wrapper {
		margin: 2.5rem 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.carousel-track-container {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.carousel-track {
		list-style: none;
		margin: 0;
		padding: 0;
		flex: 1;
		min-width: 0;
		display: flex;
		justify-content: center;
	}

	.carousel-slide {
		display: none;
	}

	.carousel-slide.active {
		display: block;
		max-width: 100%;
		animation: fadeIn 0.25s ease-in-out;
	}

	@keyframes fadeIn {
		from {
			opacity: 0.4;
			transform: scale(0.99);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	.carousel-slide img {
		max-width: 100%;
		max-height: 520px;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: var(--radius);
		box-shadow: 0 4px 20px rgb(0 0 0 / 25%);
	}

	.carousel-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--bg-surface);
		border: 1px solid var(--border);
		color: var(--fg-muted);
		cursor: pointer;
		transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
	}

	.carousel-btn:hover {
		color: var(--accent);
		background: var(--bg-surface-hover);
		border-color: var(--border-hover);
	}

	.carousel-caption-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin: 0;
	}

	.slide-caption {
		font-size: 0.875rem;
		color: var(--fg-muted);
		line-height: 1.4;
	}

	.carousel-counter {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--fg-dim);
		white-space: nowrap;
	}

	.carousel-thumbnails {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		overflow-y: visible;
		padding: 4px 2px;
		margin: -4px -2px;
		scrollbar-width: thin;
	}

	.thumb-btn {
		flex: 0 0 64px;
		height: 48px;
		border-radius: 4px;
		border: 1px solid var(--border);
		background: var(--bg);
		overflow: hidden;
		cursor: pointer;
		padding: 0;
		opacity: 0.6;
		transition: opacity 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
	}

	.thumb-btn img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.thumb-btn:hover {
		opacity: 0.9;
		border-color: var(--border-hover);
	}

	.thumb-btn.active {
		opacity: 1;
		border-color: var(--accent);
		transform: scale(1.05);
	}

	@media (max-width: 600px) {
		.carousel-wrapper {
			margin: 1.75rem 0;
			gap: 0.5rem;
		}

		.carousel-slide img {
			max-height: 320px;
		}

		.slide-caption {
			font-size: 0.8rem;
		}

		.thumb-btn {
			flex: 0 0 52px;
			height: 38px;
		}
	}
</style>
