---
interface ScreenshotItem {
	src: string;
	caption?: string;
	alt?: string;
}

interface Props {
	items: ScreenshotItem[];
	id?: string;
}

const { items, id = "carousel" } = Astro.props;
---

{items && items.length > 0 && (
	<div class="carousel-wrapper" id={id}>
		<div class="carousel-header">
			<span class="carousel-title">Screenshots</span>
			<div class="carousel-controls">
				<button class="carousel-btn prev-btn" aria-label="Previous screenshot" type="button">
					<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
						<path fill="currentColor" d="M9.78 12.78a.75.75 0 0 1-1.06 0L4.47 8.53a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 1.06L6.06 8l3.72 3.72a.75.75 0 0 1 0 1.06Z" />
					</svg>
				</button>
				<span class="carousel-counter">
					<span class="current-index">1</span> / <span class="total-count">{items.length}</span>
				</span>
				<button class="carousel-btn next-btn" aria-label="Next screenshot" type="button">
					<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
						<path fill="currentColor" d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z" />
					</svg>
				</button>
			</div>
		</div>

		<div class="carousel-track-container">
			<ul class="carousel-track">
				{items.map((item, index) => (
					<li class={`carousel-slide ${index === 0 ? "active" : ""}`} data-index={index}>
						<div class="slide-inner">
							<img src={item.src} alt={item.alt || item.caption || `Screenshot ${index + 1}`} loading="lazy" />
							{item.caption && <p class="slide-caption">{item.caption}</p>}
						</div>
					</li>
				))}
			</ul>
		</div>

		<div class="carousel-thumbnails">
			{items.map((item, index) => (
				<button
					class={`thumb-btn ${index === 0 ? "active" : ""}`}
					data-thumb={index}
					type="button"
					aria-label={`Go to slide ${index + 1}`}
				>
					<img src={item.src} alt="" aria-hidden="true" />
				</button>
			))}
		</div>
	</div>
)}

<script>
	function setupCarousels() {
		const carousels = document.querySelectorAll('.carousel-wrapper');

		carousels.forEach((carousel) => {
			const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide');
			const thumbs = carousel.querySelectorAll<HTMLElement>('.thumb-btn');
			const prevBtn = carousel.querySelector<HTMLButtonElement>('.prev-btn');
			const nextBtn = carousel.querySelector<HTMLButtonElement>('.next-btn');
			const counter = carousel.querySelector<HTMLElement>('.current-index');
			let currentIndex = 0;
			const total = slides.length;

			if (total === 0) return;

			function updateSlide(newIndex: number) {
				if (newIndex < 0) newIndex = total - 1;
				if (newIndex >= total) newIndex = 0;
				currentIndex = newIndex;

				slides.forEach((s, i) => {
					s.classList.toggle('active', i === currentIndex);
				});

				thumbs.forEach((t, i) => {
					t.classList.toggle('active', i === currentIndex);
					if (i === currentIndex) {
						t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
					}
				});

				if (counter) {
					counter.textContent = String(currentIndex + 1);
				}
			}

			prevBtn?.addEventListener('click', () => updateSlide(currentIndex - 1));
			nextBtn?.addEventListener('click', () => updateSlide(currentIndex + 1));

			thumbs.forEach((thumb, i) => {
				thumb.addEventListener('click', () => updateSlide(i));
			});

			// Keyboard arrow navigation when focused inside carousel
			carousel.addEventListener('keydown', (e: Event) => {
				const keyEvent = e as KeyboardEvent;
				if (keyEvent.key === 'ArrowLeft') {
					updateSlide(currentIndex - 1);
				} else if (keyEvent.key === 'ArrowRight') {
					updateSlide(currentIndex + 1);
				}
			});
		});
	}

	setupCarousels();
	document.addEventListener('astro:page-load', setupCarousels);
</script>

<style>
	.carousel-wrapper {
		margin: 2.5rem 0;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-surface);
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.carousel-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--border);
	}

	.carousel-title {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--fg);
		letter-spacing: -0.01em;
	}

	.carousel-controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.carousel-counter {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--fg-muted);
		min-width: 3rem;
		text-align: center;
	}

	.carousel-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius);
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--fg);
		cursor: pointer;
		transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.carousel-btn:hover {
		background: var(--bg-surface-hover);
		border-color: var(--border-hover);
		color: var(--accent);
	}

	.carousel-track-container {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--bg);
		min-height: 280px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.carousel-track {
		list-style: none;
		margin: 0;
		padding: 0;
		width: 100%;
	}

	.carousel-slide {
		display: none;
		width: 100%;
		text-align: center;
	}

	.carousel-slide.active {
		display: block;
		animation: fadeIn 0.25s ease-in-out;
	}

	@keyframes fadeIn {
		from {
			opacity: 0.4;
			transform: scale(0.99);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	.slide-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 1rem;
	}

	.slide-inner img {
		max-width: 100%;
		max-height: 520px;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: calc(var(--radius) - 2px);
		box-shadow: 0 4px 20px rgb(0 0 0 / 25%);
	}

	.slide-caption {
		margin-top: 0.75rem;
		margin-bottom: 0;
		font-size: 0.875rem;
		color: var(--fg-muted);
		line-height: 1.4;
		max-width: 600px;
	}

	.carousel-thumbnails {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		padding-top: 0.5rem;
		padding-bottom: 0.25rem;
		scrollbar-width: thin;
	}

	.thumb-btn {
		flex: 0 0 64px;
		height: 48px;
		border-radius: 4px;
		border: 1px solid var(--border);
		background: var(--bg);
		overflow: hidden;
		cursor: pointer;
		padding: 0;
		opacity: 0.6;
		transition: opacity 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
	}

	.thumb-btn img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.thumb-btn:hover {
		opacity: 0.9;
		border-color: var(--border-hover);
	}

	.thumb-btn.active {
		opacity: 1;
		border-color: var(--accent);
		transform: scale(1.05);
	}
</style>

