---
interface ScreenshotItem {
	src: string;
	caption?: string;
	alt?: string;
}

interface Props {
	items: ScreenshotItem[];
	id?: string;
}

const { items, id = "carousel" } = Astro.props;
---

{items && items.length > 0 && (
	<figure class="carousel-wrapper my-8 flex flex-col gap-3" id={id}>
		<div class="relative flex items-center justify-center gap-3">
			<button class="carousel-btn prev-btn inline-flex items-center justify-center w-8 h-8 shrink-0 rounded-full bg-bg-surface hover:bg-bg-surface-hover border border-border hover:border-border-hover text-fg-muted hover:text-accent transition-colors cursor-pointer" aria-label="Previous screenshot" type="button">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path fill="currentColor" d="M9.78 12.78a.75.75 0 0 1-1.06 0L4.47 8.53a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 1.06L6.06 8l3.72 3.72a.75.75 0 0 1 0 1.06Z" />
				</svg>
			</button>

			<ul class="carousel-track list-none m-0 p-0 flex-1 min-w-0 flex justify-center">
				{items.map((item, index) => (
					<li class={`carousel-slide ${index === 0 ? "block" : "hidden"} max-w-full`} data-index={index}>
						<img src={item.src} alt={item.alt || item.caption || `Screenshot ${index + 1}`} loading="lazy" class="max-w-full max-h-130 w-auto h-auto object-contain rounded-lg shadow-xl" />
					</li>
				))}
			</ul>

			<button class="carousel-btn next-btn inline-flex items-center justify-center w-8 h-8 shrink-0 rounded-full bg-bg-surface hover:bg-bg-surface-hover border border-border hover:border-border-hover text-fg-muted hover:text-accent transition-colors cursor-pointer" aria-label="Next screenshot" type="button">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
					<path fill="currentColor" d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z" />
				</svg>
			</button>
		</div>

		<figcaption class="flex items-baseline justify-between gap-4 m-0">
			<span class="slide-caption text-sm text-fg-muted leading-snug">{items[0]?.caption}</span>
			<span class="font-mono text-xs text-fg-dim shrink-0">
				<span class="current-index">1</span> / <span class="total-count">{items.length}</span>
			</span>
		</figcaption>

		{items.length > 1 && (
			<div class="flex gap-2 overflow-x-auto py-1 -my-1">
				{items.map((item, index) => (
					<button
						class={`thumb-btn ${index === 0 ? "opacity-100 border-accent scale-105" : "opacity-60 border-border"} shrink-0 w-16 h-12 rounded border bg-bg overflow-hidden cursor-pointer p-0 transition-all hover:opacity-90 hover:border-border-hover`}
						data-thumb={index}
						type="button"
						aria-label={`Go to slide ${index + 1}`}
					>
						<img src={item.src} alt="" aria-hidden="true" class="w-full h-full object-cover block" />
					</button>
				))}
			</div>
		)}
	</figure>
)}

<script>
	function setupCarousels() {
		const carousels = document.querySelectorAll('.carousel-wrapper');

		carousels.forEach((carousel) => {
			if (carousel.hasAttribute('data-initialized')) return;
			carousel.setAttribute('data-initialized', 'true');

			const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide');
			const thumbs = carousel.querySelectorAll<HTMLElement>('.thumb-btn');
			const prevBtn = carousel.querySelector<HTMLButtonElement>('.prev-btn');
			const nextBtn = carousel.querySelector<HTMLButtonElement>('.next-btn');
			const counter = carousel.querySelector<HTMLElement>('.current-index');
			const captionEl = carousel.querySelector<HTMLElement>('.slide-caption');
			const captions = Array.from(slides).map((s) => {
				const img = s.querySelector('img');
				return img?.getAttribute('alt') || '';
			});
			let currentIndex = 0;
			const total = slides.length;

			if (total === 0) return;

			function updateSlide(newIndex: number) {
				if (newIndex < 0) newIndex = total - 1;
				if (newIndex >= total) newIndex = 0;
				currentIndex = newIndex;

				slides.forEach((s, i) => {
					if (i === currentIndex) {
						s.classList.remove('hidden');
						s.classList.add('block');
					} else {
						s.classList.add('hidden');
						s.classList.remove('block');
					}
				});

				thumbs.forEach((t, i) => {
					if (i === currentIndex) {
						t.classList.add('opacity-100', 'border-accent', 'scale-105');
						t.classList.remove('opacity-60', 'border-border');
						t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
					} else {
						t.classList.remove('opacity-100', 'border-accent', 'scale-105');
						t.classList.add('opacity-60', 'border-border');
					}
				});

				if (counter) {
					counter.textContent = String(currentIndex + 1);
				}

				if (captionEl) {
					captionEl.textContent = captions[currentIndex] || '';
				}
			}

			prevBtn?.addEventListener('click', () => updateSlide(currentIndex - 1));
			nextBtn?.addEventListener('click', () => updateSlide(currentIndex + 1));

			thumbs.forEach((thumb, i) => {
				thumb.addEventListener('click', () => updateSlide(i));
			});

			carousel.addEventListener('keydown', (e: Event) => {
				const keyEvent = e as KeyboardEvent;
				if (keyEvent.key === 'ArrowLeft') {
					updateSlide(currentIndex - 1);
				} else if (keyEvent.key === 'ArrowRight') {
					updateSlide(currentIndex + 1);
				}
			});
		});
	}

	setupCarousels();
	document.addEventListener('astro:page-load', setupCarousels);
</script>
