---
interface Props {
	name: string;
	slug: string;
	tagline: string;
	tech: string[];
	stars: number;
	github: string;
}

const { name, slug, tagline, tech, stars, github } = Astro.props;
---

<article class="project-card">
	<div class="card-main">
		<div class="card-title-row">
			<h3 class="project-name">
				<a href={`/projects/${slug}`} class="project-title-link">
					{name}
				</a>
			</h3>
			<a
				href={`${github}/stargazers`}
				target="_blank"
				rel="noopener noreferrer"
				class="stars-badge"
				title={`View ${stars.toLocaleString()} stars on GitHub`}
				aria-label={`${stars} GitHub stars`}
			>
				<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
					></path>
				</svg>
				<span>{stars.toLocaleString()}</span>
			</a>
		</div>
		<p class="tagline">{tagline}</p>
		<div class="tech-stack">
			{tech.map((item) => (
				<span class="tech-pill">{item}</span>
			))}
		</div>
	</div>
	<div class="card-arrow" aria-hidden="true">
		<span>&rarr;</span>
	</div>
</article>

<style>
	.project-card {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1.15rem 1.25rem;
		background: var(--bg-surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
	}

	.project-card:hover {
		border-color: var(--border-hover);
		background-color: var(--bg-surface-hover);
		transform: translateY(-2px);
	}

	.card-main {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
		flex-grow: 1;
	}

	.card-title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.project-name {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.02em;
	}

	.project-title-link {
		color: var(--fg);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	/* Stretched link: makes the entire card clickable */
	.project-title-link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: var(--radius);
	}

	.project-card:hover .project-title-link {
		color: #ffffff;
	}

	/* Keep stars badge clickable above the stretched link */
	.stars-badge {
		position: relative;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--fg-muted);
		font-size: 0.75rem;
		font-family: var(--font-mono);
		text-decoration: none;
		padding: 0.2rem 0.55rem;
		border-radius: var(--radius-sm);
		background: var(--bg-subtle);
		border: 1px solid var(--border);
		transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
		flex-shrink: 0;
	}

	.stars-badge svg {
		color: #eab308;
		flex-shrink: 0;
	}

	.stars-badge:hover {
		border-color: var(--border-hover);
		color: #ffffff;
		background: var(--bg-surface);
	}

	.tagline {
		margin: 0 0 0.4rem 0;
		color: var(--fg-muted);
		font-size: 0.875rem;
		line-height: 1.5;
	}

	.tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tech-pill {
		font-size: 0.685rem;
		font-family: var(--font-mono);
		color: var(--fg-dim);
		background: var(--bg-subtle);
		border: 1px solid var(--border);
		padding: 0.12rem 0.45rem;
		border-radius: var(--radius-sm);
		letter-spacing: 0.02em;
	}

	.card-arrow {
		color: var(--fg-dim);
		font-family: var(--font-mono);
		font-size: 1.15rem;
		flex-shrink: 0;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.project-card:hover .card-arrow {
		color: var(--fg);
		transform: translateX(4px);
	}

	@media (max-width: 600px) {
		.project-card {
			padding: 0.85rem;
			gap: 0.75rem;
		}

		.card-arrow {
			display: none;
		}
	}
</style>
