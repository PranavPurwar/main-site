---
interface Props {
	name: string;
	slug: string;
	tagline: string;
	tech: string[];
	stars: number;
	github: string;
}

const { name, slug, tagline, tech, stars, github } = Astro.props;
---

<article class="group relative flex items-center justify-between gap-5 p-4 sm:p-5 bg-bg-surface hover:bg-bg-surface-hover border border-border hover:border-border-hover rounded-lg transition-all duration-200 hover:-translate-y-0.5">
	<div class="flex flex-col gap-1.5 min-w-0 grow">
		<div class="flex items-center justify-between gap-3">
			<h3 class="m-0 font-display text-lg font-bold tracking-tight text-fg group-hover:text-white transition-colors">
				<a href={`/projects/${slug}`} class="text-inherit no-underline after:absolute after:inset-0 after:z-1 after:rounded-lg">
					{name}
				</a>
			</h3>
			<a
				href={`${github}/stargazers`}
				target="_blank"
				rel="noopener noreferrer"
				class="relative z-2 inline-flex items-center gap-1.5 text-xs font-mono text-fg-muted hover:text-white px-2.5 py-1 rounded bg-bg-subtle hover:bg-bg-surface border border-border hover:border-border-hover transition-colors shrink-0 no-underline"
				title={`View ${stars.toLocaleString()} stars on GitHub`}
				aria-label={`${stars} GitHub stars`}
			>
				<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" class="text-yellow-500 shrink-0">
					<path
						fill="currentColor"
						d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
					></path>
				</svg>
				<span>{stars.toLocaleString()}</span>
			</a>
		</div>
		<p class="m-0 text-sm text-fg-muted leading-relaxed line-clamp-2">{tagline}</p>
		<div class="flex flex-wrap gap-1.5 mt-1">
			{tech.map((item) => (
				<span class="text-[0.685rem] font-mono text-fg-dim bg-bg-subtle border border-border px-2 py-0.5 rounded tracking-wide">
					{item}
				</span>
			))}
		</div>
	</div>
	<div class="hidden sm:block text-fg-dim group-hover:text-fg font-mono text-lg transition-transform duration-200 group-hover:translate-x-1 shrink-0" aria-hidden="true">
		&rarr;
	</div>
</article>
