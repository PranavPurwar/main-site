---
interface Props {
	name: string;
	slug: string;
	tagline: string;
	description: string;
	tech: string[];
	stars: number;
	github: string;
	featured?: boolean;
	index?: number;
}

const {
	name,
	slug,
	tagline,
	description,
	tech,
	stars,
	github,
	featured = false,
	index = 1,
} = Astro.props;

const formattedIndex = String(index).padStart(2, '0');
---

<article
	class:list={[
		'project-card has-footer group',
		featured ? 'project-card--lead' : 'project-card--half',
	]}
>
	<header class="project-card-header flex items-baseline justify-between gap-4">
		<div class="flex items-baseline gap-3 min-w-0">
			<span class="font-serif italic text-xl sm:text-2xl text-editorial-accent leading-none select-none shrink-0" aria-hidden="true">
				{formattedIndex}
			</span>
			<h3
				class:list={[
					'font-display font-bold tracking-tight text-on-surface group-hover:text-primary transition-colors m-0 leading-tight min-w-0',
					featured ? 'text-2xl sm:text-3xl' : 'text-xl sm:text-2xl',
				]}
			>
				<a href={`/projects/${slug}`} class="card-link text-inherit no-underline">
					{name}
				</a>
			</h3>
		</div>
	</header>

	<div
		class:list={[
			'project-card-body',
			featured
				? 'grid grid-cols-1 lg:grid-cols-[1.2fr_0.85fr] gap-6 items-center'
				: 'flex flex-col justify-between gap-4',
		]}
	>
		{featured ? (
			<>
				<div class="space-y-2.5">
					<p class="text-base font-medium text-on-surface leading-snug m-0">
						{tagline}
					</p>
					<p class="text-sm text-on-surface-variant leading-relaxed m-0">
						{description}
					</p>
				</div>

				<div class="rounded-xl bg-surface-container p-4 border border-outline-variant/60 font-mono text-xs flex flex-col gap-2.5" aria-hidden="true">
					<div class="flex items-center justify-between gap-2 pb-2 border-b border-outline-variant/50 text-[0.7rem] text-on-surface-variant">
						<span class="truncate">tty0 &middot; aarch64 &middot; glibc 2.39</span>
						<span class="w-1.5 h-1.5 rounded-full bg-editorial-accent shrink-0"></span>
					</div>
					<div class="flex items-center gap-2 text-on-surface">
						<span class="text-editorial-accent select-none">$</span>
						<span class="truncate">pacman -S jdk21-openjdk rust-analyzer</span>
					</div>
					<div class="flex items-center justify-between gap-2 text-[0.72rem] text-on-surface-variant">
						<span class="truncate">LSP &middot; jdtls &middot; metals &middot; clangd</span>
						<span class="text-editorial-accent font-medium shrink-0">Ready</span>
					</div>
				</div>
			</>
		) : slug === 'reef' ? (
			<>
				<div class="space-y-2.5">
					<p class="text-[15px] sm:text-base font-medium text-on-surface leading-snug m-0">
						{tagline}
					</p>
					<p class="text-sm text-on-surface-variant leading-relaxed line-clamp-2 m-0">
						{description}
					</p>
				</div>

				<div class="rounded-xl bg-surface-container px-4 py-3 border border-outline-variant/60 flex flex-col gap-2.5" aria-hidden="true">
					<div class="flex items-center justify-between gap-2 text-xs">
						<span class="font-medium text-on-surface">Focus Session &middot; 09:00 &ndash; 12:00</span>
						<span class="px-2 py-0.5 rounded-full bg-surface-container-high border border-outline-variant/50 text-editorial-accent font-mono text-[0.7rem] font-medium shrink-0">
							35m left
						</span>
					</div>
					<div class="h-1.5 w-full rounded-full bg-surface-container-highest overflow-hidden">
						<div class="h-full w-2/3 bg-editorial-accent rounded-full"></div>
					</div>
				</div>
			</>
		) : (
			<div class="space-y-2.5">
				<p class="text-[15px] sm:text-base font-medium text-on-surface leading-snug m-0">
					{tagline}
				</p>
				<p class="text-sm text-on-surface-variant leading-relaxed line-clamp-3 m-0">
					{description}
				</p>
			</div>
		)}
	</div>

	<footer class="project-card-footer pt-4 border-t border-outline-variant/50 flex items-center justify-between gap-4 flex-wrap">
		{tech.length > 0 && (
			<ul class="tag-list" aria-label="Technologies">
				{tech.slice(0, featured ? 6 : 4).map((item) => (
					<li class="px-2.5 py-0.5 rounded-md font-mono text-xs font-semibold bg-secondary-container text-on-secondary-container border border-outline-variant/70">
						{item}
					</li>
				))}
			</ul>
		)}

		<span class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-editorial-accent group-hover:translate-x-0.5 transition-transform shrink-0 ml-auto" aria-hidden="true">
			<span>Explore</span>
			<span>&rarr;</span>
		</span>
	</footer>
</article>
