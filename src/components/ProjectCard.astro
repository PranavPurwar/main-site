---
interface Props {
	name: string;
	slug: string;
	tagline: string;
	tech: string[];
	stars: number;
}

const { name, slug, tagline, tech, stars } = Astro.props;
---

<a href={`/projects/${slug}`} class="project-card">
	<div class="card-header">
		<h3 class="project-name">{name}</h3>
		<span class="stars" aria-label={`${stars} GitHub stars`}>
			<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
				<path
					fill="currentColor"
					d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
				></path>
			</svg>
			<span>{stars}</span>
		</span>
	</div>
	<p class="tagline">{tagline}</p>
	<div class="tech-stack">
		{tech.map((item) => (
			<span class="tech-pill">{item}</span>
		))}
	</div>
</a>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		background: var(--bg-surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.25rem;
		text-decoration: none;
		color: var(--fg);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.project-card:hover {
		border-color: var(--border-hover);
		transform: translateY(-2px);
	}

	.card-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.project-name {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--fg);
	}

	.stars {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--fg-muted);
		font-size: 0.8125rem;
		font-family: var(--font-mono);
		white-space: nowrap;
		flex-shrink: 0;
		padding-top: 0.15rem;
	}

	.stars svg {
		flex-shrink: 0;
	}

	.tagline {
		margin: 0 0 1rem 0;
		color: var(--fg-muted);
		font-size: 0.875rem;
		line-height: 1.5;
		flex-grow: 1;
	}

	.tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-top: auto;
	}

	.tech-pill {
		font-size: 0.75rem;
		font-family: var(--font-mono);
		padding: 0.15rem 0.5rem;
		border-radius: 9999px;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--fg-muted);
		line-height: 1.4;
	}
</style>
