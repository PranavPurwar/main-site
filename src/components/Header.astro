---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, AVATAR_URL } from '../consts';
---

<aside id="app-sidebar" class="w-full lg:w-60 lg:sticky lg:top-8 shrink-0 flex flex-col py-4 lg:py-8 border-b lg:border-b-0 lg:border-r border-border">
	<header class="flex items-center justify-between gap-4">
		<a href="/" class="flex items-center gap-3.5 group no-underline text-inherit">
			<img src={AVATAR_URL} alt="Pranav Purwar" class="w-14 h-14 lg:w-16 lg:h-16 rounded-full object-cover border-2 border-border group-hover:border-accent transition-colors shrink-0 shadow-md" width="64" height="64" />
			<div class="flex flex-col min-w-0">
				<span class="font-display text-base lg:text-lg font-extrabold text-fg tracking-tight group-hover:text-accent transition-colors leading-tight">{SITE_TITLE}</span>
				<p class="text-xs text-fg-dim leading-snug m-0 mt-0.5">Systems, Compilers &amp; Android Developer</p>
			</div>
		</a>
		<button
			id="sidebar-toggle"
			class="lg:hidden p-2 text-fg-muted hover:text-fg rounded-md border border-border bg-bg-surface cursor-pointer"
			type="button"
			aria-label="Toggle navigation menu"
			aria-expanded="false"
			aria-controls="sidebar-nav"
		>
			<svg id="icon-open" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="18" x2="21" y2="18"></line>
			</svg>
			<svg id="icon-close" class="hidden" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</header>

	<div id="sidebar-nav" class="hidden lg:flex flex-col gap-6 mt-6 lg:mt-8">
		<nav class="flex flex-col gap-1">
			<HeaderLink href="/">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
				<span>HOME</span>
			</HeaderLink>
			<HeaderLink href="/projects">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
				<span>PROJECTS</span>
			</HeaderLink>
			<HeaderLink href="/blog">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
				<span>BLOG</span>
			</HeaderLink>
			<HeaderLink href="/about">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
				<span>ABOUT</span>
			</HeaderLink>
		</nav>

		<div class="flex flex-col gap-3 pt-4 border-t border-border">
			<div class="flex items-center gap-3.5 text-fg-dim">
				<a href="https://github.com/PranavPurwar" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:text-accent transition-colors no-underline">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
				</a>
				<a href="https://www.linkedin.com/in/pranavpurwar" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hover:text-accent transition-colors no-underline">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
				</a>
				<a href="mailto:contact@invokevirtual.org" aria-label="Email" class="hover:text-accent transition-colors no-underline">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
				</a>
				<a href="/rss.xml" aria-label="RSS Feed" class="hover:text-accent transition-colors no-underline">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
				</a>
			</div>
			<div class="font-mono text-[0.7rem] text-fg-dim">&copy; {new Date().getFullYear()} Pranav Purwar</div>
		</div>
	</div>
</aside>

<script>
	function setupSidebarNav() {
		const toggleBtn = document.getElementById('sidebar-toggle');
		const sidebarNav = document.getElementById('sidebar-nav');
		const iconOpen = document.getElementById('icon-open');
		const iconClose = document.getElementById('icon-close');

		if (!toggleBtn || toggleBtn.hasAttribute('data-initialized')) return;
		toggleBtn.setAttribute('data-initialized', 'true');

		function closeSidebar() {
			toggleBtn?.setAttribute('aria-expanded', 'false');
			sidebarNav?.classList.add('hidden');
			sidebarNav?.classList.remove('flex');
			iconOpen?.classList.remove('hidden');
			iconClose?.classList.add('hidden');
		}

		toggleBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
			const newExpanded = !isExpanded;
			toggleBtn.setAttribute('aria-expanded', String(newExpanded));

			if (newExpanded) {
				sidebarNav?.classList.remove('hidden');
				sidebarNav?.classList.add('flex');
				iconOpen?.classList.add('hidden');
				iconClose?.classList.remove('hidden');
			} else {
				closeSidebar();
			}
		});

		sidebarNav?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				if (window.innerWidth < 1024) {
					closeSidebar();
				}
			});
		});

		document.addEventListener('click', (e) => {
			if (window.innerWidth < 1024 && !toggleBtn.contains(e.target as Node) && !sidebarNav?.contains(e.target as Node)) {
				closeSidebar();
			}
		});
	}

	setupSidebarNav();
	document.addEventListener('astro:page-load', setupSidebarNav);
</script>
