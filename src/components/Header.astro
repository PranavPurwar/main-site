---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, AVATAR_URL } from '../consts';
---

<aside id="app-sidebar" class="w-full lg:w-64 lg:sticky lg:top-10 shrink-0 flex flex-col py-4 lg:py-8 border-b lg:border-b-0 lg:border-r border-outline-variant/60 lg:pr-6">
	<header class="flex items-center justify-between gap-4">
		<a href="/" class="flex items-center gap-3.5 group no-underline text-inherit">
			<img src={AVATAR_URL} alt="Pranav Purwar" class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl object-cover border border-outline-variant/60 group-hover:border-primary transition-all duration-300 shrink-0" width="56" height="56" />
			<div class="flex flex-col min-w-0">
				<span class="font-display text-base font-bold text-on-surface tracking-tight group-hover:text-primary transition-colors leading-tight">{SITE_TITLE}</span>
				<p class="font-serif italic text-sm text-editorial-accent leading-snug m-0 mt-0.5">Systems &amp; Android</p>
			</div>
		</a>

		<div class="flex items-center gap-2 lg:hidden">
			<button
				type="button"
				class="theme-toggle w-10 h-10 flex items-center justify-center rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-all cursor-pointer active:scale-95"
				title="Toggle color theme"
			>
				<span class="theme-toggle-light-label items-center justify-center">
					<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
					<span class="sr-only">Switch to light theme</span>
				</span>
				<span class="theme-toggle-dark-label items-center justify-center">
					<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
					<span class="sr-only">Switch to dark theme</span>
				</span>
			</button>

			<button
				id="sidebar-toggle"
				class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-on-surface transition-all cursor-pointer active:scale-95"
				type="button"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
				aria-controls="sidebar-nav"
			>
				<svg id="icon-open" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
				<svg id="icon-close" class="hidden" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
	</header>

	<div id="sidebar-nav" class="hidden lg:flex flex-col gap-6 mt-6 lg:mt-8">
		<nav class="flex flex-col gap-1.5" aria-label="Main navigation">
			<HeaderLink href="/">
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
				<span>Home</span>
			</HeaderLink>
			<HeaderLink href="/projects">
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
				<span>Projects</span>
			</HeaderLink>
			<HeaderLink href="/blog">
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
				<span>Writing</span>
			</HeaderLink>
			<HeaderLink href="/about">
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
				<span>About</span>
			</HeaderLink>
			<HeaderLink href="/sponsor">
				<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
				<span>Sponsor</span>
			</HeaderLink>
		</nav>

		<div class="flex flex-col gap-3.5 pt-6 border-t border-outline-variant/60">
			<div class="flex items-center justify-between gap-2">
				<div class="flex items-center flex-wrap gap-2">
					<a href="https://github.com/PranavPurwar" target="_blank" rel="noopener noreferrer" aria-label="GitHub Profile" class="w-9 h-9 rounded-full bg-surface-container hover:bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-primary transition-all active:scale-95 no-underline" title="GitHub Profile">
						<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
					</a>
					<a href="https://www.linkedin.com/in/pranavpurwar" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Profile" class="w-9 h-9 rounded-full bg-surface-container hover:bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-primary transition-all active:scale-95 no-underline" title="LinkedIn Profile">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
					</a>
					<a href="mailto:contact@invokevirtual.org" aria-label="Send Email" class="w-9 h-9 rounded-full bg-surface-container hover:bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-primary transition-all active:scale-95 no-underline" title="Send Email">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
					</a>
					<a href="/rss.xml" aria-label="RSS Feed" class="w-9 h-9 rounded-full bg-surface-container hover:bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-primary transition-all active:scale-95 no-underline" title="RSS Feed">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
					</a>
				</div>

				<button
					type="button"
					class="theme-toggle hidden lg:inline-flex w-9 h-9 rounded-full bg-surface-container hover:bg-surface-container-high items-center justify-center text-on-surface-variant hover:text-editorial-accent transition-all active:scale-95 cursor-pointer shrink-0"
					title="Toggle color theme"
				>
					<span class="theme-toggle-light-label items-center justify-center">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
						<span class="sr-only">Switch to light theme</span>
					</span>
					<span class="theme-toggle-dark-label items-center justify-center">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
						<span class="sr-only">Switch to dark theme</span>
					</span>
				</button>
			</div>
			<div class="font-mono text-[0.7rem] text-on-surface-variant">&copy; {new Date().getFullYear()} Pranav Purwar</div>
		</div>
	</div>
</aside>

<script>
	function getRenderedScheme(): 'light' | 'dark' {
		const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
		return meta?.getAttribute('content') === 'dark' ? 'dark' : 'light';
	}

	function applyColorScheme(value: 'light' | 'dark') {
		const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
		if (meta) meta.setAttribute('content', value);
	}

	function setupThemeToggle() {
		document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
			if (btn.hasAttribute('data-theme-initialized')) return;
			btn.setAttribute('data-theme-initialized', 'true');

			btn.addEventListener('click', () => {
				const target: 'light' | 'dark' = getRenderedScheme() === 'dark' ? 'light' : 'dark';
				try {
					localStorage.setItem('color-scheme', target);
				} catch {}
				applyColorScheme(target);
			});
		});

		if (!(window as Window & { __themeStorageBound?: boolean }).__themeStorageBound) {
			(window as Window & { __themeStorageBound?: boolean }).__themeStorageBound = true;
			window.addEventListener('storage', (e) => {
				if (e.key !== 'color-scheme' && e.key !== null) return;
				const next: 'light' | 'dark' = e.newValue === 'dark' ? 'dark' : 'light';
				applyColorScheme(next);
			});
		}
	}

	function setupSidebarNav() {
		const toggleBtn = document.getElementById('sidebar-toggle');
		const sidebarNav = document.getElementById('sidebar-nav');
		const iconOpen = document.getElementById('icon-open');
		const iconClose = document.getElementById('icon-close');

		if (!toggleBtn || toggleBtn.hasAttribute('data-initialized')) return;
		toggleBtn.setAttribute('data-initialized', 'true');

		function closeSidebar() {
			toggleBtn?.setAttribute('aria-expanded', 'false');
			sidebarNav?.classList.add('hidden');
			sidebarNav?.classList.remove('flex');
			iconOpen?.classList.remove('hidden');
			iconClose?.classList.add('hidden');
		}

		toggleBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
			const newExpanded = !isExpanded;
			toggleBtn.setAttribute('aria-expanded', String(newExpanded));

			if (newExpanded) {
				sidebarNav?.classList.remove('hidden');
				sidebarNav?.classList.add('flex');
				iconOpen?.classList.add('hidden');
				iconClose?.classList.remove('hidden');
			} else {
				closeSidebar();
			}
		});

		sidebarNav?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				if (window.innerWidth < 1024) {
					closeSidebar();
				}
			});
		});

		document.addEventListener('click', (e) => {
			if (window.innerWidth < 1024 && !toggleBtn.contains(e.target as Node) && !sidebarNav?.contains(e.target as Node)) {
				closeSidebar();
			}
		});
	}

	setupThemeToggle();
	setupSidebarNav();
	document.addEventListener('astro:page-load', () => {
		setupThemeToggle();
		setupSidebarNav();
	});
</script>
