---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
				border-radius: var(--radius);
				overflow: hidden;
				border: 1px solid var(--border);
				background: var(--bg-surface);
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				max-height: 420px;
				object-fit: cover;
				border-radius: 0;
			}

			.article-header {
				margin-bottom: 2.5rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--border);
			}

			.article-meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.825rem;
				color: var(--fg-dim);
			}

			.last-updated-on {
				font-style: italic;
			}

			.description {
				font-size: 1.1rem;
				color: var(--fg-muted);
				line-height: 1.6;
				margin: 0;
			}

			.prose {
				color: var(--fg);
				line-height: 1.8;
			}

			.prose :global(h2) {
				margin-top: 2.5rem;
				margin-bottom: 1rem;
				font-size: 1.35rem;
				font-weight: 600;
				color: var(--fg);
				letter-spacing: -0.015em;
			}

			.prose :global(h3) {
				margin-top: 2rem;
				margin-bottom: 0.75rem;
				font-size: 1.15rem;
				font-weight: 600;
				color: var(--fg);
				letter-spacing: -0.01em;
			}

			.prose :global(p) {
				margin-bottom: 1.4em;
				color: var(--fg-muted);
				font-size: 1rem;
				line-height: 1.75;
			}

			.prose :global(ul),
			.prose :global(ol) {
				padding-left: 1.5rem;
				margin-bottom: 1.5rem;
				color: var(--fg-muted);
				font-size: 0.975rem;
			}

			.prose :global(li) {
				margin-bottom: 0.5rem;
				line-height: 1.65;
			}

			.prose :global(pre) {
				margin: 1.75rem 0;
			}

			.prose :global(blockquote) {
				margin: 1.75rem 0;
			}

			@media (max-width: 640px) {
				.description {
					font-size: 0.975rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<a href="/blog" class="back-link">&larr; Back to Writing</a>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<header class="article-header">
					<div class="article-meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="last-updated-on">
								(Updated: <FormattedDate date={updatedDate} />)
							</span>
						)}
					</div>
					<h1>{title}</h1>
					{description && <p class="description">{description}</p>}
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
