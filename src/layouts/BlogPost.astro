---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="bg-bg text-fg antialiased">
		<div class="w-full max-w-310 mx-auto min-h-screen px-4 flex flex-col lg:grid lg:grid-cols-[245px_1fr] gap-8 items-start">
			<Header />
			<main class="w-full py-8 min-w-0">
				<a href="/blog" class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-accent hover:text-white transition-transform hover:-translate-x-1 mb-6 no-underline">&larr; Back to Writing</a>
				<article>
					{heroImage && (
						<div class="w-full mb-8 rounded-lg overflow-hidden border border-border bg-bg-surface">
							<img width={1020} height={510} src={heroImage} alt="" class="block w-full h-auto max-h-100 object-cover" />
						</div>
					)}
					<header class="mb-10 pb-8 border-b border-border">
						<div class="flex items-center gap-4 mb-3 font-mono text-xs text-fg-dim">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<span class="italic">
									(Updated: <FormattedDate date={updatedDate} />)
								</span>
							)}
						</div>
						<h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-fg-heading m-0 mb-3">{title}</h1>
						{description && <p class="text-base sm:text-lg text-fg-muted leading-relaxed m-0">{description}</p>}
					</header>
					<div class="prose">
						<slot />
					</div>
				</article>
				<Footer />
			</main>
		</div>
	</body>
</html>
