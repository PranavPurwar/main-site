---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Project } from '../consts';

type Props = Project;

const {
	name,
	slug,
	tagline,
	description,
	tech,
	stars,
	forks,
	github,
	features,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${name} — Pranav Purwar`} description={tagline} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": name,
			"description": tagline,
			"applicationCategory": "DeveloperApplication",
			"operatingSystem": "Android, Linux",
			"codeRepository": github,
			"author": {
				"@type": "Person",
				"name": "Pranav Purwar",
				"url": "https://invokevirtual.org"
			}
		})} />
	</head>
	<body class="bg-surface text-on-surface antialiased selection:bg-primary selection:text-on-primary">
		<div class="w-full max-w-[1520px] mx-auto min-h-screen px-4 sm:px-6 lg:px-8 flex flex-col lg:grid lg:grid-cols-[256px_1fr] gap-6 lg:gap-8 xl:gap-10 items-start">
			<Header />
			<main class="w-full py-6 lg:py-8 min-w-0">
				<a href="/projects" class="inline-flex items-center gap-1.5 font-mono text-xs text-on-surface-variant hover:text-primary transition-colors mb-6 no-underline">
					<span>&larr;</span>
					<span>Back to Projects</span>
				</a>

				<header class="mb-8 pb-8 border-b border-outline-variant/60 animate-m3-fade-up">
					<p class="font-serif italic text-xl text-editorial-accent m-0 mb-2">
						System // {name}
					</p>
					<h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-on-surface m-0 mb-3">{name}</h1>
					<p class="text-base sm:text-lg text-on-surface-variant leading-relaxed m-0 mb-6 max-w-2xl">{tagline}</p>

					<div class="flex flex-wrap items-center gap-3 mb-5">
						<a
							href={github}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full font-medium text-sm bg-primary text-on-primary hover:opacity-95 active:scale-[0.98] transition-all duration-200 no-underline"
							aria-label={`View ${name} on GitHub`}
						>
							<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
								<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
							</svg>
							<span>View on GitHub &rarr;</span>
						</a>

						<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full font-mono text-xs text-on-surface bg-surface-container-high border border-outline-variant/60" title={`${stars} GitHub stars`}>
							<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" class="text-editorial-accent">
								<path
									fill="currentColor"
									d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
								></path>
							</svg>
							<span>{stars} stars</span>
						</span>

						<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full font-mono text-xs text-on-surface bg-surface-container-high border border-outline-variant/60" title={`${forks} forks`}>
							<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" class="text-on-surface-variant">
								<path
									fill="currentColor"
									d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"
								></path>
							</svg>
							<span>{forks} forks</span>
						</span>
					</div>

					{tech && tech.length > 0 && (
						<div class="flex flex-wrap gap-1.5 mt-4">
							{tech.map((item) => (
								<span class="inline-flex items-center px-2.5 py-0.5 rounded-md font-mono text-xs font-semibold bg-secondary-container text-on-secondary-container border border-outline-variant/70">
									{item}
								</span>
							))}
						</div>
					)}
				</header>

				<div class="prose max-w-none">
					<p>{description}</p>

					{features && features.length > 0 && (
						<>
							<h2>Key Features</h2>
							<ul>
								{features.map((feature) => <li>{feature}</li>)}
							</ul>
						</>
					)}

					<slot />
				</div>
				<Footer />
			</main>
		</div>
	</body>
</html>