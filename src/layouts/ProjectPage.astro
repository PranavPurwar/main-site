---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Project } from '../consts';

type Props = Project;

const {
	name,
	slug,
	tagline,
	description,
	tech,
	stars,
	forks,
	github,
	features,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${name} — Pranav Purwar`} description={tagline} />
	</head>
	<body class="bg-bg text-fg antialiased">
		<div class="w-full max-w-310 mx-auto min-h-screen px-4 flex flex-col lg:grid lg:grid-cols-[245px_1fr] gap-8 items-start">
			<Header />
			<main class="w-full py-8 min-w-0">
				<a href="/projects" class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-accent hover:text-white transition-transform hover:-translate-x-1 mb-6 no-underline">&larr; Back to Projects</a>

				<header class="mb-8 pb-8 border-b border-border">
					<div class="inline-flex items-center gap-2 font-mono text-xs text-accent uppercase tracking-wider mb-3">
						<span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
						<span>Open Source</span>
					</div>
					<h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-fg-heading m-0 mb-3">{name}</h1>
					<p class="text-base sm:text-lg text-fg-muted leading-relaxed m-0 mb-6 max-w-2xl">{tagline}</p>

					<div class="flex flex-wrap items-center gap-2.5 mb-5">
						<a
							href={github}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-6 py-4 rounded-full font-mono text-xs font-bold uppercase tracking-wider bg-accent hover:bg-accent-hover text-white! shadow-sm transition-all hover:-translate-y-0.5 no-underline"
							aria-label={`View ${name} on GitHub`}
						>
							<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
								<path
									fill="currentColor"
									d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
								></path>
							</svg>
							<span>View on GitHub &rarr;</span>
						</a>

						<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-mono text-xs text-fg-muted bg-bg-surface border border-border" title={`${stars} GitHub stars`}>
							<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" class="text-yellow-500">
								<path
									fill="currentColor"
									d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
								></path>
							</svg>
							<span>{stars} stars</span>
						</span>

						<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-mono text-xs text-fg-muted bg-bg-surface border border-border" title={`${forks} forks`}>
							<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" class="text-fg-dim">
								<path
									fill="currentColor"
									d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"
								></path>
							</svg>
							<span>{forks} forks</span>
						</span>
					</div>

					{tech && tech.length > 0 && (
						<div class="flex flex-wrap gap-1.5 mt-3">
							{tech.map((item) => (
								<span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-[0.7rem] font-semibold uppercase tracking-wider bg-bg-surface text-fg-muted border border-border">
									{item}
								</span>
							))}
						</div>
					)}
				</header>

				<div class="prose mt-8 pt-8 border-t border-border">
					<p>{description}</p>

					{features && features.length > 0 && (
						<>
							<h2>Key Features</h2>
							<ul>
								{features.map((feature) => <li>{feature}</li>)}
							</ul>
						</>
					)}

					<slot />
				</div>
				<Footer />
			</main>
		</div>
	</body>
</html>