---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Project } from '../consts';

type Props = Project;

const {
	name,
	slug,
	tagline,
	description,
	tech,
	stars,
	forks,
	github,
	features,
	screenshot,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${name} — Pranav Purwar`} description={tagline} />
	</head>
	<body>
		<Header />
		<main>
			<a href="/projects" class="back-link">&larr; Back to Projects</a>

			<header class="project-header">
				<h1>{name}</h1>
				<p class="tagline">{tagline}</p>

				<div class="stats-bar">
					<span class="stat-item" title={`${stars} GitHub stars`}>
						<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path
								fill="currentColor"
								d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
							></path>
						</svg>
						<span>{stars}</span>
					</span>

					<span class="stat-item" title={`${forks} forks`}>
						<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path
								fill="currentColor"
								d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"
							></path>
						</svg>
						<span>{forks}</span>
					</span>

					<a
						href={github}
						target="_blank"
						rel="noopener noreferrer"
						class="github-btn"
						aria-label={`View ${name} on GitHub`}
					>
						<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path>
						</svg>
						<span>View on GitHub</span>
					</a>
				</div>

				{tech && tech.length > 0 && (
					<div class="tech-tags">
						{tech.map((item) => (
							<span class="tech-pill">{item}</span>
						))}
					</div>
				)}
			</header>

			<section class="description-section">
				<p>{description}</p>
			</section>

			{features && features.length > 0 && (
				<section class="features-section">
					<h2>Features</h2>
					<ul>
						{features.map((feature) => (
							<li>{feature}</li>
						))}
					</ul>
				</section>
			)}

			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 2.5rem 1rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		color: var(--fg-muted);
		font-size: 0.875rem;
		text-decoration: none;
		margin-bottom: 1.75rem;
		transition: color 0.15s ease;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.project-header {
		margin-bottom: 2.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border);
	}

	h1 {
		font-size: 2.25rem;
		font-weight: 700;
		color: var(--fg);
		letter-spacing: -0.02em;
		margin: 0 0 0.5rem 0;
	}

	.tagline {
		font-size: 1.125rem;
		color: var(--fg-muted);
		line-height: 1.5;
		margin: 0 0 1.25rem 0;
	}

	.stats-bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 1.25rem;
	}

	.stat-item {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--fg-muted);
		font-size: 0.875rem;
		font-family: var(--font-mono);
	}

	.stat-item svg {
		color: var(--fg-dim);
		flex-shrink: 0;
	}

	.github-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		background: var(--bg-surface);
		border: 1px solid var(--border);
		color: var(--fg);
		padding: 0.35rem 0.75rem;
		border-radius: var(--radius);
		font-size: 0.8125rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.github-btn:hover {
		background: var(--bg-surface-hover);
		border-color: var(--border-hover);
		color: var(--fg);
	}

	.github-btn svg {
		flex-shrink: 0;
	}

	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.tech-pill {
		font-size: 0.75rem;
		font-family: var(--font-mono);
		padding: 0.15rem 0.5rem;
		border-radius: 9999px;
		background: var(--bg-surface);
		border: 1px solid var(--border);
		color: var(--fg-muted);
		line-height: 1.4;
	}

	.description-section {
		margin-bottom: 2.5rem;
	}

	.description-section p {
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--fg);
		margin: 0;
	}

	.features-section {
		margin-bottom: 2.5rem;
	}

	.features-section h2 {
		font-size: 1.35rem;
		font-weight: 600;
		margin: 0 0 1rem 0;
		color: var(--fg);
	}

	.features-section ul {
		list-style: disc;
		padding-left: 1.25rem;
		margin: 0;
	}

	.features-section li {
		color: var(--fg-muted);
		line-height: 1.6;
		margin-bottom: 0.5rem;
	}

	@media (max-width: 640px) {
		main {
			padding: 1.5rem 1rem;
		}

		h1 {
			font-size: 1.85rem;
		}

		.tagline {
			font-size: 1rem;
		}
	}
</style>
