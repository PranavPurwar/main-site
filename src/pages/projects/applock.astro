---
import ProjectPage from '../../layouts/ProjectPage.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';
import { PROJECTS } from '../../consts';

const project = PROJECTS.find((p) => p.slug === 'applock')!;

const screenshots = [
	{
		src: '/projects/applock/1-feature-graphic.png',
		caption: 'AppLock banner: Open-source privacy security guard for Android',
		alt: 'AppLock feature graphic'
	},
	{
		src: '/projects/applock/2-app-list.png',
		caption: 'Applications manager: toggle locking status for installed software',
		alt: 'AppLock app list'
	},
	{
		src: '/projects/applock/3-settings.png',
		caption: 'Security preferences, authentication triggers, and auto-lock timeouts',
		alt: 'AppLock settings view'
	},
	{
		src: '/projects/applock/4-password-screen.png',
		caption: 'PIN and biometric challenge overlay with clean Material 3 design',
		alt: 'AppLock password unlock screen'
	},
	{
		src: '/projects/applock/5-set-password.png',
		caption: 'Setup wizard for Master PIN configuration and recovery methods',
		alt: 'Set password screen'
	},
	{
		src: '/projects/applock/6-unlock-time.png',
		caption: 'Granular unlock timeout controls (immediately, screen off, or customized interval)',
		alt: 'Unlock timeout configuration'
	}
];
---

<ProjectPage {...project}>
	<ProjectCarousel items={screenshots} id="applock-carousel" />

	<section class="project-deepdive">
		<h2>Privacy & Security Architecture</h2>
		<p>
			Most Android app lockers monetize user data through intrusive background ad SDKs and analytics trackers. AppLock was engineered from day one as a zero-telemetry alternative. It contains no network requests, no tracking libraries, and requires no cloud connectivity.
		</p>

		<h3>Core Security Pillars</h3>
		<div class="security-grid">
			<div class="security-card">
				<h4>Hardware-Backed Biometrics</h4>
				<p>Interfaces with the official Android <code>BiometricPrompt</code> API, delegating key validation to the device's hardware Secure Element / StrongBox enclave.</p>
			</div>
			<div class="security-card">
				<h4>Overlay Protection</h4>
				<p>Uses high-priority window manager overlay channels with anti-tampering guards to intercept app launch events instantly before sensitive contents render.</p>
			</div>
			<div class="security-card">
				<h4>Modern Jetpack Compose UI</h4>
				<p>100% declarative UI built with Material 3 Expressive and dynamic color extraction, adapting seamlessly to the user's wallpaper palette.</p>
			</div>
			<div class="security-card">
				<h4>Anti-Uninstall Measures</h4>
				<p>Prevents bad actors from bypassing the lock by requiring authentication before accessing Android's package manager or system application settings.</p>
			</div>
		</div>

		<h3>Auditing & Distribution</h3>
		<ul class="specs-list">
			<li><strong>Zero Telemetry:</strong> Tested and verified on VirusTotal with zero flags and zero outbound network permissions</li>
			<li><strong>F-Droid & IzzyOnDroid:</strong> Reproducible build recipes available via open-source package repositories</li>
			<li><strong>Storage:</strong> Fully encrypted local configuration stored via Jetpack Room with SQLCipher integration</li>
		</ul>
	</section>
</ProjectPage>

<style>
	.project-deepdive {
		margin-top: 3rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
	}

	.project-deepdive h2 {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 1rem;
		color: var(--fg);
	}

	.project-deepdive h3 {
		font-size: 1.25rem;
		font-weight: 600;
		margin: 2rem 0 1rem;
		color: var(--fg);
	}

	.project-deepdive p {
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--fg-muted);
		margin-bottom: 1.25rem;
	}

	.security-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		margin: 1.5rem 0 2rem;
	}

	.security-card {
		background: var(--bg-surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.25rem;
	}

	.security-card h4 {
		font-size: 1rem;
		font-weight: 600;
		color: var(--fg);
		margin: 0 0 0.5rem 0;
	}

	.security-card p {
		font-size: 0.925rem;
		line-height: 1.6;
		margin: 0;
		color: var(--fg-muted);
	}

	.specs-list {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.specs-list li {
		font-size: 0.95rem;
		color: var(--fg-muted);
		padding: 0.75rem 1rem;
		background: var(--bg-surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.specs-list strong {
		color: var(--fg);
	}

	@media (max-width: 640px) {
		.security-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
