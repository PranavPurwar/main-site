---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectsWithLiveStars } from '../../lib/github';

const projects = await getProjectsWithLiveStars();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects — Pranav Purwar"
			description="My open-source developer tools, JVM compiler ports, and mobile systems."
		/>
	</head>
	<body class="bg-bg text-fg antialiased">
		<div class="w-full max-w-[1240px] mx-auto min-h-screen px-4 flex flex-col lg:grid lg:grid-cols-[245px_1fr] gap-8 items-start">
			<Header />
			<main class="w-full py-8 min-w-0">
				<div class="mb-8 pb-6 border-b border-border">
					<span class="font-mono text-xs font-semibold uppercase tracking-wider text-fg-dim block mb-1">SOFTWARE &amp; TOOLS</span>
					<h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-fg-heading m-0 mb-2">Projects &amp; Software</h1>
					<p class="text-base sm:text-lg text-fg-muted leading-relaxed m-0">My open-source developer tools, compiler ports, and mobile systems.</p>
				</div>

				<div class="flex flex-col gap-3.5">
					{projects.map((project) => (
						<ProjectCard {...project} />
					))}
				</div>
				<Footer />
			</main>
		</div>
	</body>
</html>
