---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectsWithLiveStars } from '../../lib/github';

const projects = await getProjectsWithLiveStars();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects — Pranav Purwar"
			description="My open-source developer tools, JVM compiler ports, and mobile systems."
		/>
	</head>
	<body>
		<div class="app-container">
			<Header />
			<main>
				<div class="projects-header">
					<span class="mono-subtitle">SOFTWARE &amp; TOOLS</span>
					<h1>Projects &amp; Software</h1>
					<p class="subtitle">My open-source developer tools, compiler ports, and mobile systems.</p>
				</div>

				<div class="project-list">
					{projects.map((project) => (
						<ProjectCard {...project} />
					))}
				</div>
				<Footer />
			</main>
		</div>
	</body>
</html>

<style>
	.projects-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	.subtitle {
		font-size: 1.05rem;
		color: var(--fg-muted);
		margin: 0;
	}

	.project-list {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	@media (max-width: 600px) {
		.subtitle {
			font-size: 0.95rem;
		}

		.project-list {
			gap: 0.75rem;
		}
	}
</style>
