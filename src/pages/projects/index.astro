---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { PROJECTS } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects — Pranav Purwar"
			description="Open-source tools, apps, and libraries."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="projects-header">
				<h1>Projects</h1>
				<p class="subtitle">Open-source tools, apps, and libraries.</p>
			</div>

			<div class="project-grid">
				{PROJECTS.map((project) => (
					<ProjectCard {...project} />
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 3rem 1rem;
	}

	.projects-header {
		margin-bottom: 2.5rem;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--fg);
		margin: 0 0 0.5rem 0;
		letter-spacing: -0.02em;
	}

	.subtitle {
		font-size: 1.15rem;
		color: var(--fg-muted);
		margin: 0;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 900px) {
		.project-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		main {
			padding: 2rem 1rem;
		}

		h1 {
			font-size: 2rem;
		}

		.subtitle {
			font-size: 1rem;
		}

		.project-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
