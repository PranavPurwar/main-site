---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { PROJECTS } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Projects — Pranav Purwar"
			description="Open-source tools, apps, and libraries."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="projects-header">
				<h1>Projects</h1>
				<p class="subtitle">Open-source tools, apps, and libraries.</p>
			</div>

			<div class="project-list">
				{PROJECTS.map((project) => (
					<ProjectCard {...project} />
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.projects-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	.subtitle {
		font-size: 1.05rem;
		color: var(--fg-muted);
		margin: 0;
	}

	.project-list {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	@media (max-width: 600px) {
		.subtitle {
			font-size: 0.95rem;
		}

		.project-list {
			gap: 0.75rem;
		}
	}
</style>
