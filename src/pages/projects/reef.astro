---
import ProjectPage from '../../layouts/ProjectPage.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';
import { PROJECTS } from '../../consts';

const project = PROJECTS.find((p) => p.slug === 'reef')!;

const screenshots = [
	{
		src: '/projects/reef/1-dashboard.png',
		caption: 'Reef home dashboard: Daily screen time trends, active routine timeline, and focus state',
		alt: 'Reef dashboard screen'
	},
	{
		src: '/projects/reef/2-limits.png',
		caption: 'Per-app daily time allowances and gentle notification threshold settings',
		alt: 'App limits configuration'
	},
	{
		src: '/projects/reef/3-routines.png',
		caption: 'Automated focus routines: schedule distraction blocks across custom days and hours',
		alt: 'Daily routine scheduler'
	},
	{
		src: '/projects/reef/4-stats.png',
		caption: 'Interactive hourly usage breakdowns and historical behavioral analytics',
		alt: 'Screen time statistics'
	},
	{
		src: '/projects/reef/5-focus-mode.png',
		caption: 'Pomodoro focus timer with configurable work-to-break intervals and system DND trigger',
		alt: 'Focus mode session'
	},
	{
		src: '/projects/reef/6-mindful.png',
		caption: 'Mindful Launch: A deliberate breathing pause before opening compulsive apps',
		alt: 'Mindful launch prompt'
	}
];
---

<ProjectPage {...project}>
	<ProjectCarousel items={screenshots} id="reef-carousel" />

	<section class="project-deepdive">
		<h2>Design Philosophy &amp; Wellbeing Engineering</h2>
		<p>
			Commercial digital wellbeing tools frequently introduce gamification gimmicks, subscriptions, or intrusive data collection. Reef was built to solve compulsive screen usage transparently: zero advertisements, zero tracking telemetry, zero subscriptions, and complete offline privacy.
		</p>

		<h3>Core Focus Mechanics</h3>
		<div class="deepdive-grid">
			<div class="deepdive-card">
				<h4>Routines &amp; Time Blocks</h4>
				<p>Construct recurring time windows that restrict high-friction applications while keeping communication tools available.</p>
			</div>
			<div class="deepdive-card">
				<h4>Mindful Launch</h4>
				<p>Introduces a configurable friction pause (e.g. 5-second breathing countdown) before launching distracting apps, breaking reflexive muscle memory.</p>
			</div>
			<div class="deepdive-card">
				<h4>Pomodoro &amp; Count-Up Modes</h4>
				<p>Supports traditional interval work cycles as well as open-ended count-up timers with configurable work-to-break ratio calculations.</p>
			</div>
			<div class="deepdive-card">
				<h4>Material You Expression</h4>
				<p>Crafted following Material 3 Expressive guidelines, incorporating organic shapes, smooth transitions, and dynamic contrast ratios.</p>
			</div>
		</div>

		<h3>Technical Specifications</h3>
		<ul class="specs-list">
			<li><strong>Stack:</strong> 100% Kotlin with declarative Jetpack Compose UI architecture</li>
			<li><strong>Background Engine:</strong> Battery-efficient WorkManager jobs for scheduled routine transitions</li>
			<li><strong>Distribution:</strong> Published independently on IzzyOnDroid and Weblate for community localization</li>
			<li><strong>Privacy:</strong> All usage statistics remain strictly on-device inside encrypted SQLite databases</li>
		</ul>
	</section>
</ProjectPage>
