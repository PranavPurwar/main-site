---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Writing & Notes — ${SITE_TITLE}`}
			description="Articles, engineering notes, and deep dives on JVM internals, Android virtualization, and build systems."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-header">
				<h1>Writing &amp; Notes</h1>
				<p class="subtitle">
					Technical articles, compiler porting deep dives, and system architecture thoughts.
				</p>
			</div>

			<section class="posts-list">
				{posts.map((post) => (
					<article class="post-item">
						<a href={`/blog/${post.id}/`} class="post-link">
							<div class="post-meta">
								<time datetime={post.data.pubDate.toISOString()} class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</time>
								{post.data.heroImage && (
									<span class="has-cover">Article</span>
								)}
							</div>
							<h2 class="post-title">{post.data.title}</h2>
							{post.data.description && (
								<p class="post-desc">{post.data.description}</p>
							)}
							<span class="read-more">Read article &rarr;</span>
						</a>
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--border);
	}

	.subtitle {
		font-size: 1.05rem;
		color: var(--fg-muted);
		line-height: 1.6;
		margin: 0;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
	}

	.post-item {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-surface);
		transition: border-color 0.18s ease, transform 0.18s ease, background-color 0.18s ease;
	}

	.post-item:hover {
		border-color: var(--card-border-active);
		background-color: var(--bg-surface-hover);
		transform: translateY(-2px);
	}

	.post-link {
		display: block;
		padding: 1rem 1.15rem;
		text-decoration: none;
		color: inherit;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.45rem;
	}

	.post-date {
		font-family: var(--font-mono);
		font-size: 0.775rem;
		color: var(--fg-dim);
	}

	.has-cover {
		font-family: var(--font-mono);
		font-size: 0.675rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.1rem 0.45rem;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 9999px;
		color: var(--accent);
	}

	.post-title {
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--fg);
		margin: 0 0 0.45rem 0;
		line-height: 1.35;
		letter-spacing: -0.015em;
		transition: color 0.15s ease;
	}

	.post-link:hover .post-title {
		color: var(--accent-hover);
	}

	.post-desc {
		font-size: 0.875rem;
		color: var(--fg-muted);
		line-height: 1.6;
		margin: 0 0 0.75rem 0;
	}

	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.8rem;
		color: var(--accent);
		font-weight: 500;
		transition: gap 0.15s ease, color 0.15s ease;
	}

	.post-link:hover .read-more {
		color: var(--accent-hover);
		gap: 0.45rem;
	}

	@media (max-width: 640px) {
		.post-link {
			padding: 0.85rem;
		}

		.post-title {
			font-size: 1.05rem;
		}
	}
</style>
