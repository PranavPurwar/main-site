---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Writing & Notes — ${SITE_TITLE}`}
			description="My technical articles, porting deep dives, and notes on JVM internals and Android virtualization."
		/>
	</head>
	<body>
		<div class="app-container">
			<Header />
			<main>
				<div class="blog-header">
					<span class="mono-subtitle">ARTICLES & DEEP DIVES</span>
					<h1>Writing &amp; Notes</h1>
					<p class="subtitle">
						My technical articles, porting deep dives, and system architecture notes.
					</p>
				</div>

				<section class="posts-list">
					{posts.map((post) => (
						<article class="post-item">
							<a href={`/blog/${post.id}/`} class="post-link">
								<div class="post-meta">
									<time datetime={post.data.pubDate.toISOString()} class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</time>
									<span class="meta-sep">&bull;</span>
									<span class="tldr-chip">{post.data.tags ? `▣ ${post.data.tags[0].toUpperCase()}` : '▣ ARTICLE'}</span>
								</div>
								<h2 class="post-title">{post.data.title}</h2>
								{post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
								<span class="read-more">Read article &rarr;</span>
							</a>
						</article>
					))}
				</section>
				<Footer />
			</main>
		</div>
	</body>
</html>

<style>
	.blog-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--border);
	}

	.subtitle {
		font-size: 1.05rem;
		color: var(--fg-muted);
		line-height: 1.6;
		margin: 0;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
	}

	.post-item {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-surface);
		transition: border-color 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
	}

	.post-item:hover {
		border-color: var(--accent);
		background-color: var(--bg-surface-hover);
		transform: translateY(-2px);
	}

	.post-link {
		display: block;
		padding: 1.25rem 1.35rem;
		text-decoration: none;
		color: inherit;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
	}

	.post-date {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--fg-dim);
	}

	.meta-sep {
		color: var(--border-hover);
	}

	.post-title {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 0.45rem 0;
		line-height: 1.3;
		letter-spacing: -0.02em;
		transition: color 0.15s ease;
	}

	.post-link:hover .post-title {
		color: var(--accent);
	}

	.post-desc {
		font-size: 0.9rem;
		color: var(--fg-muted);
		line-height: 1.6;
		margin: 0 0 0.85rem 0;
	}

	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.775rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent);
		transition: gap 0.15s ease, color 0.15s ease;
	}

	.post-link:hover .read-more {
		color: #ffffff;
		gap: 0.55rem;
	}

	@media (max-width: 640px) {
		.post-link {
			padding: 0.95rem;
		}

		.post-title {
			font-size: 1.15rem;
		}
	}
</style>
