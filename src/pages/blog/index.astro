---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Writing & Notes — ${SITE_TITLE}`}
			description="My technical articles, porting deep dives, and notes on JVM internals and Android virtualization."
		/>
	</head>
	<body class="bg-bg text-fg antialiased">
		<div class="w-full max-w-[1240px] mx-auto min-h-screen px-4 flex flex-col lg:grid lg:grid-cols-[245px_1fr] gap-8 items-start">
			<Header />
			<main class="w-full py-8 min-w-0">
				<div class="mb-10 pb-7 border-b border-border">
					<span class="font-mono text-xs font-semibold uppercase tracking-wider text-fg-dim block mb-1">ARTICLES &amp; DEEP DIVES</span>
					<h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-fg-heading m-0 mb-2">Writing &amp; Notes</h1>
					<p class="text-base sm:text-lg text-fg-muted leading-relaxed m-0">
						My technical articles, porting deep dives, and system architecture notes.
					</p>
				</div>

				<section class="flex flex-col gap-4">
					{posts.map((post) => (
						<article class="border border-border hover:border-accent rounded-lg bg-bg-surface hover:bg-bg-surface-hover transition-all duration-200 hover:-translate-y-0.5">
							<a href={`/blog/${post.id}/`} class="block p-5 sm:p-6 no-underline text-inherit group">
								<div class="flex items-center gap-2.5 mb-2 font-mono text-xs text-fg-dim">
									<time datetime={post.data.pubDate.toISOString()}>
										<FormattedDate date={post.data.pubDate} />
									</time>
									<span>&bull;</span>
									<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded font-mono text-[0.7rem] font-semibold uppercase tracking-wider bg-bg-surface text-fg-muted border border-border group-hover:border-border-hover group-hover:text-fg transition-colors">
										{post.data.tags ? `▣ ${post.data.tags[0].toUpperCase()}` : '▣ ARTICLE'}
									</span>
								</div>
								<h2 class="font-display text-xl sm:text-2xl font-extrabold text-white group-hover:text-accent transition-colors m-0 mb-2 leading-snug">
									{post.data.title}
								</h2>
								{post.data.description && (
									<p class="text-sm sm:text-base text-fg-muted leading-relaxed m-0 mb-4">{post.data.description}</p>
								)}
								<span class="inline-flex items-center gap-1.5 font-mono text-xs font-bold tracking-wider uppercase text-accent group-hover:text-white group-hover:translate-x-1 transition-all">
									Read article &rarr;
								</span>
							</a>
						</article>
					))}
				</section>
				<Footer />
			</main>
		</div>
	</body>
</html>
