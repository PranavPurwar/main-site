---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AVATAR_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About — Pranav Purwar"
			description="I'm a systems engineer focused on JVM internals, Android virtualization, and developer tooling."
		/>
	</head>
	<body class="bg-bg text-fg antialiased">
		<div class="w-full max-w-310 mx-auto min-h-screen px-4 flex flex-col lg:grid lg:grid-cols-[245px_1fr] gap-8 items-start">
			<Header />
			<main class="w-full py-8 min-w-0">
				<div class="flex items-center gap-6 mb-10 pb-8 border-b border-border">
					<div class="shrink-0">
						<img src={AVATAR_URL} alt="Pranav Purwar" class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-border shadow-xl block" width="76" height="76" />
					</div>
					<div class="flex flex-col gap-1">
						<span class="font-mono text-xs font-semibold uppercase tracking-wider text-fg-dim">PROFILE &amp; BIO</span>
						<h1 class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-fg-heading m-0">Pranav Purwar</h1>
						<p class="font-mono text-xs sm:text-sm text-fg-dim m-0">@PranavPurwar &bull; <span class="text-accent font-medium">invokevirtual</span></p>
						<p class="text-xs sm:text-sm text-fg-muted m-0 mt-0.5">Systems Engineer &bull; Open Source Developer</p>
					</div>
				</div>

				<div class="flex flex-col gap-4 text-base text-fg leading-relaxed mb-10">
					<p class="m-0">
						I am a systems engineer focused on JVM internals, Android virtualization, and developer tooling. I build tools that enable writing, compiling, and running code directly on mobile devices without relying on external servers or cloud environments.
					</p>

					<p class="m-0">
						I founded Cosmic IDE, a general-purpose IDE for Android powered by an embedded Arch Linux ARM environment that runs completely without root access. As part of enabling on-device compilation, I ported standard compiler toolchains to Android's runtime, including kotlinc-android and javac-android.
					</p>

					<p class="m-0">
						I run <a href="https://github.com/aload0" target="_blank" rel="noopener noreferrer" aria-label="aload0">aload0</a>, where I build and publish privacy-focused Android applications including AppLock and Reef, designed to protect personal privacy with zero telemetry or ads. I also co-founded <a href="https://github.com/aload0" target="_blank" rel="noopener noreferrer" aria-label="Bryte-Edu">Bryte-Edu</a> to develop educational developer tooling aimed at students working on accessible, low-spec hardware.
					</p>
				</div>

				<section class="grid grid-cols-1 md:grid-cols-3 gap-4 my-10">
					<div class="p-5 rounded-lg bg-bg-surface border border-border">
						<h3 class="font-display text-base font-bold text-fg-heading m-0 mb-2">Android &amp; Virtualization</h3>
						<p class="text-sm text-fg-muted leading-relaxed m-0">Simulated userlands, Arch Linux containers, and hardware-backed biometric security architectures.</p>
					</div>
					<div class="p-5 rounded-lg bg-bg-surface border border-border">
						<h3 class="font-display text-base font-bold text-fg-heading m-0 mb-2">JVM &amp; Compilers</h3>
						<p class="text-sm text-fg-muted leading-relaxed m-0">Patched OpenJDK javac and kotlinc compiler toolchains running on mobile ART runtimes.</p>
					</div>
					<div class="p-5 rounded-lg bg-bg-surface border border-border">
						<h3 class="font-display text-base font-bold text-fg-heading m-0 mb-2">Privacy &amp; Tooling</h3>
						<p class="text-sm text-fg-muted leading-relaxed m-0">Zero-telemetry open-source utilities distributed transparently through F-Droid and IzzyOnDroid.</p>
					</div>
				</section>

				<section class="p-6 rounded-lg bg-bg-surface border border-border mt-10">
					<h2 class="font-display text-xl font-bold tracking-tight text-fg-heading m-0 mb-2">Get in touch</h2>
					<p class="text-sm sm:text-base text-fg-muted leading-relaxed m-0">
						Email me directly at <a href="mailto:contact@invokevirtual.org">contact@invokevirtual.org</a> or explore my code and active issues on <a href="https://github.com/PranavPurwar" target="_blank" rel="noopener noreferrer">GitHub &rarr;</a>
					</p>
				</section>
				<Footer />
			</main>
		</div>
	</body>
</html>
