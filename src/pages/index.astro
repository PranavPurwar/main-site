---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getProjectsWithLiveStars } from '../lib/github';

const projects = await getProjectsWithLiveStars();
const HOME_SLUGS = ['cosmic-ide', 'reef', 'invoke'];
const selectedProjects = HOME_SLUGS
	.map((slug) => projects.find((p) => p.slug === slug))
	.filter((p): p is (typeof projects)[number] => Boolean(p));
const [leadProject, ...gridProjects] = selectedProjects;

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = allPosts.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Pranav Purwar",
			"alternateName": "invoke",
			"url": "https://invokevirtual.org",
			"jobTitle": "Systems & Android Software Engineer",
			"description": "Systems programmer and Android developer building open-source developer tools, privacy utilities, and native mobile software in Kotlin and Rust.",
			"sameAs": [
				"https://github.com/PranavPurwar",
				"https://www.linkedin.com/in/pranavpurwar"
			],
			"knowsAbout": [
				"Android Internals",
				"JVM Compilers",
				"Linux Kernel & Runtimes",
				"PRoot & System Call Emulation",
				"Kotlin & Java"
			]
		})} />
	</head>
	<body class="bg-surface text-on-surface antialiased selection:bg-primary selection:text-on-primary">
		<div class="w-full max-w-[1520px] mx-auto min-h-screen px-4 sm:px-6 lg:px-8 flex flex-col lg:grid lg:grid-cols-[256px_1fr] gap-6 lg:gap-8 xl:gap-10 items-start">
			<Header />

			<main class="w-full py-6 lg:py-8 min-w-0">
				<section class="mb-14 pb-9 border-b border-outline-variant/60 animate-m3-fade-up">
					<p class="font-mono text-xs uppercase tracking-[0.16em] text-editorial-accent m-0 mb-3">
						Android &amp; Systems Engineer
					</p>
					<h1 class="font-display text-3xl sm:text-4xl lg:text-[2.75rem] font-bold tracking-tight leading-[1.12] text-on-surface m-0 mb-4 max-w-4xl">
						Pranav Purwar
					</h1>
					<p class="text-base sm:text-lg text-on-surface-variant leading-relaxed m-0 max-w-2xl mb-7">
						I build Android apps, developer tools, and open-source software.
					</p>
					<div class="flex flex-wrap items-center gap-3">
						<a
							href="/projects"
							class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary text-on-primary font-medium text-sm hover:opacity-95 transition-all no-underline"
						>
							<span>View Projects</span>
							<span aria-hidden="true">&rarr;</span>
						</a>
						<a
							href="https://github.com/PranavPurwar"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface font-medium text-sm border border-outline-variant/60 transition-colors no-underline"
						>
							<span>GitHub</span>
							<span class="text-on-surface-variant" aria-hidden="true">&#8599;</span>
						</a>
						<a
							href="/about"
							class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-on-surface font-medium text-sm border border-outline-variant/60 transition-colors no-underline"
						>
							About
						</a>
					</div>
				</section>

				<section class="mb-16 animate-m3-fade-up m3-stagger-1">
					<div class="flex items-baseline justify-between gap-4 mb-6 pb-3 border-b border-outline-variant/50">
						<div class="flex items-baseline gap-3">
							<span class="font-serif italic text-2xl sm:text-3xl text-editorial-accent leading-none">01</span>
							<span class="font-mono text-xs text-outline-variant select-none" aria-hidden="true">/</span>
							<h2 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-on-surface m-0">
								Selected Works
							</h2>
						</div>
						<a
							href="/projects"
							class="font-mono text-xs font-medium text-on-surface-variant hover:text-editorial-accent transition-colors inline-flex items-center gap-1 no-underline shrink-0"
						>
							<span>Index ({String(projects.length).padStart(2, '0')})</span>
							<span aria-hidden="true">&rarr;</span>
						</a>
					</div>

					<div class="project-bento-grid">
						{leadProject && <ProjectCard {...leadProject} featured={true} index={1} />}
						{gridProjects.map((project, idx) => (
							<ProjectCard {...project} featured={false} index={idx + 2} />
						))}
					</div>
				</section>

				<section class="mb-12 animate-m3-fade-up m3-stagger-2">
					<div class="flex items-baseline justify-between gap-4 mb-6 pb-3 border-b border-outline-variant/50">
						<div class="flex items-baseline gap-3">
							<span class="font-serif italic text-2xl sm:text-3xl text-editorial-accent leading-none">02</span>
							<span class="font-mono text-xs text-outline-variant select-none" aria-hidden="true">/</span>
							<h2 class="font-display text-xl sm:text-2xl font-bold tracking-tight text-on-surface m-0">
								Technical Writing
							</h2>
						</div>
						<a
							href="/blog"
							class="font-mono text-xs font-medium text-on-surface-variant hover:text-editorial-accent transition-colors inline-flex items-center gap-1 no-underline shrink-0"
						>
							<span>All posts</span>
							<span aria-hidden="true">&rarr;</span>
						</a>
					</div>

					<div class="rounded-2xl bg-surface-container-low border border-outline-variant/60 divide-y divide-outline-variant/50 overflow-hidden">
						{recentPosts.map((post, idx) => (
							<article class="relative p-5 sm:px-6 flex items-start justify-between gap-5 group hover:bg-surface-container transition-colors duration-200">
								<div class="flex items-start gap-4 min-w-0">
									<span class="font-serif italic text-xl leading-none text-editorial-accent pt-0.5 shrink-0 select-none" aria-hidden="true">
										{String(idx + 1).padStart(2, '0')}
									</span>
									<div class="flex flex-col gap-1.5 min-w-0">
										<div class="flex items-center gap-2.5 font-mono text-xs text-on-surface-variant">
											<span class="text-on-surface-variant font-medium">
												<FormattedDate date={post.data.pubDate} />
											</span>
											{post.data.tags && post.data.tags.length > 0 && (
												<span class="px-2 py-0.5 rounded-md font-mono text-[0.7rem] font-semibold bg-primary-container/60 text-on-primary-container border border-primary/20">
													#{post.data.tags[0]}
												</span>
											)}
										</div>
										<h3 class="font-display text-lg sm:text-xl font-bold tracking-tight text-on-surface group-hover:text-primary transition-colors m-0 leading-snug">
											<a href={`/blog/${post.id}/`} class="text-inherit no-underline after:absolute after:inset-0">
												{post.data.title}
											</a>
										</h3>
										{post.data.description && (
											<p class="text-sm text-on-surface-variant m-0 line-clamp-2 leading-relaxed">
												{post.data.description}
											</p>
										)}
									</div>
								</div>
								<span class="font-mono text-sm text-on-surface-variant group-hover:text-editorial-accent group-hover:translate-x-1 transition-all shrink-0 pt-1" aria-hidden="true">
									&rarr;
								</span>
							</article>
						))}
					</div>
				</section>

				<Footer />
			</main>
		</div>
	</body>
</html>
