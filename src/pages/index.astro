---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_DISPLAY } from '../consts';
import { getProjectsWithLiveStars, calculateTotalStars } from '../lib/github';

const projects = await getProjectsWithLiveStars();
const featuredProjects = projects.filter((project) => project.featured);
const totalStars = calculateTotalStars(projects);

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = allPosts.slice(0, 4);

const faqItems = [
	{
		question: "What is the primary focus of your open-source work?",
		answer: "I build developer tools, compiler infrastructure (Java/Kotlin), and rootless Linux userland that runS directly on mobile devices without relying on external cloud servers."
	},
	{
		question: "How are these compiler toolchains ported to Android?",
		answer: "I adapt upstream OpenJDK javac and Kotlin compiler toolchains to execute within Android's ART execution environment using targeted patches."
	},
	{
		question: "How can other developers get in touch or contribute?",
		answer: "All my repositories are public on GitHub (@PranavPurwar). You can submit issues, open pull requests, or reach out directly at contact@invokevirtual.org."
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-bg text-fg antialiased">
		<div class="w-full max-w-310 mx-auto min-h-screen px-4 flex flex-col lg:grid lg:grid-cols-[245px_1fr_275px] gap-8 items-start">
			<Header />

			<main class="w-full py-8 min-w-0">
				<section class="p-6 sm:p-8 rounded-xl bg-bg-surface border border-border mb-10 flex flex-col gap-3">
					<span class="font-mono text-xs font-semibold uppercase tracking-wider text-fg-dim">@{GITHUB_DISPLAY} &bull; SYSTEMS &amp; ANDROID</span>
					<h1 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-fg-heading m-0 leading-tight">
						Developer tools, compilers, and Linux environments on mobile.
					</h1>
					<p class="text-base sm:text-lg text-fg-muted leading-relaxed m-0 max-w-2xl">
						I build developer tools, IDEs, and utility for mobile devices. My work centers on Cosmic IDE and ported compiler toolchains to let developers write, compile, and run code locally on Android.
					</p>
					<div class="flex flex-wrap gap-3 mt-3">
						<a href="/projects" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-mono text-xs font-bold uppercase tracking-wider bg-accent hover:bg-accent-hover text-white! shadow-lg shadow-accent/25 hover:shadow-accent/35 transition-all hover:-translate-y-0.5 no-underline">View Projects &rarr;</a>
						<a href="https://github.com/PranavPurwar" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-mono text-xs font-bold uppercase tracking-wider bg-bg-surface hover:bg-bg-surface-hover text-fg hover:text-white border border-border hover:border-border-hover transition-all hover:-translate-y-0.5 no-underline">GitHub ({totalStars.toLocaleString()}+ Stars)</a>
					</div>
				</section>

				<section class="mb-12">
					<div class="flex items-end justify-between gap-4 mb-5 pb-3 border-b border-border">
						<div>
							<span class="font-mono text-xs font-semibold uppercase tracking-wider text-fg-dim block mb-1">SOFTWARE</span>
							<h2 class="font-display text-xl font-bold tracking-tight text-fg-heading-subtle m-0">Featured Projects</h2>
						</div>
						<a href="/projects" class="font-mono text-xs font-semibold tracking-wider uppercase text-accent hover:text-white transition-transform hover:translate-x-1 no-underline">All projects &rarr;</a>
					</div>
					<div class="flex flex-col gap-3.5">
						{featuredProjects.map((project) => (
							<ProjectCard {...project} />
						))}
					</div>
				</section>

				<section class="mb-12">
					<div class="flex items-end justify-between gap-4 mb-5 pb-3 border-b border-border">
						<div>
							<span class="font-mono text-xs font-semibold uppercase tracking-wider text-fg-dim block mb-1">PUBLICATIONS</span>
							<h2 class="font-display text-xl font-bold tracking-tight text-fg-heading-subtle m-0">Recent Writing</h2>
						</div>
						<a href="/blog" class="font-mono text-xs font-semibold tracking-wider uppercase text-accent hover:text-white transition-transform hover:translate-x-1 no-underline">All posts &rarr;</a>
					</div>
					<div class="flex flex-col">
						{recentPosts.map((post) => (
							<article class="py-4 border-b border-border last:border-b-0 flex flex-col gap-1.5">
								<div class="flex items-center gap-2 font-mono text-xs text-fg-dim">
									<time datetime={post.data.pubDate.toISOString()}>
										<FormattedDate date={post.data.pubDate} />
									</time>
								</div>
								<h3 class="font-display text-lg font-bold tracking-tight text-fg m-0">
									<a href={`/blog/${post.id}/`} class="text-fg hover:text-accent transition-colors no-underline">{post.data.title}</a>
								</h3>
								<p class="text-sm text-fg-muted m-0 line-clamp-2 leading-relaxed">{post.data.description}</p>
							</article>
						))}
					</div>
				</section>

				<!-- FAQ Section -->
				<section class="mb-12">
					<div class="flex items-end justify-between gap-4 mb-5 pb-3 border-b border-border">
						<div>
							<span class="font-mono text-xs font-semibold uppercase tracking-wider text-fg-dim block mb-1">FAQ</span>
							<h2 class="font-display text-xl font-bold tracking-tight text-fg-heading-subtle m-0">Frequently Asked</h2>
						</div>
					</div>
					<div class="flex flex-col">
						{faqItems.map((item) => (
							<details class="group border-t border-border last:border-b py-3.5 cursor-pointer">
								<summary class="flex items-center justify-between font-display text-base font-bold text-fg-heading-subtle hover:text-white transition-colors list-none cursor-pointer">
									<span>{item.question}</span>
									<span class="font-mono text-fg-dim text-lg transition-transform duration-200 group-open:rotate-45">+</span>
								</summary>
								<p class="mt-2.5 text-sm text-fg-muted leading-relaxed m-0">{item.answer}</p>
							</details>
						))}
					</div>
				</section>

				<Footer />
			</main>

			<aside class="hidden lg:flex flex-col gap-5 sticky top-8 py-8 w-70 shrink-0">
				<div class="p-4 rounded-lg bg-bg-surface border border-border flex flex-col gap-3">
					<h3 class="font-mono text-xs font-semibold tracking-wider uppercase text-fg-dim m-0">Latest Articles</h3>
					<ul class="list-none p-0 m-0 flex flex-col gap-3">
						{allPosts.slice(0, 3).map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="flex flex-col gap-0.5 group no-underline">
									<span class="font-display text-xs font-bold text-fg-heading-subtle group-hover:text-accent transition-colors line-clamp-2 leading-snug">{post.data.title}</span>
									<span class="font-mono text-[0.7rem] text-fg-dim">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>

				<div class="p-4 rounded-lg bg-bg-surface border border-border flex flex-col gap-3">
					<h3 class="font-mono text-xs font-semibold tracking-wider uppercase text-fg-dim m-0">Top Repositories</h3>
					<ul class="list-none p-0 m-0 flex flex-col gap-2.5">
						{projects.slice(0, 4).map((project) => (
							<li>
								<a
									href={project.github}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center justify-between gap-2 text-xs font-mono group no-underline"
								>
									<span class="text-fg-heading-subtle group-hover:text-accent transition-colors truncate">{project.name}</span>
									<span class="inline-flex items-center gap-1 text-[0.7rem] text-fg-dim shrink-0" title={`${project.stars.toLocaleString()} stars on GitHub`}>
										<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" class="text-yellow-500">
											<path
												fill="currentColor"
												d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
											></path>
										</svg>
										<span>{project.stars.toLocaleString()}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>

				<div class="p-4 rounded-lg bg-bg-surface border border-border flex flex-col gap-3">
					<h3 class="font-mono text-xs font-semibold tracking-wider uppercase text-fg-dim m-0">About</h3>
					<p class="text-xs text-fg-muted leading-relaxed m-0">
						I'm a systems engineer building developer tools, JVM compilers, and privacy-first software for Android.
					</p>
					<ul class="list-none p-0 m-0 flex flex-col gap-1.5 text-xs font-mono">
						<li><a href="https://github.com/PranavPurwar" target="_blank" rel="noopener" class="text-fg-muted hover:text-accent transition-colors no-underline">GitHub profile &rarr;</a></li>
						<li><a href="/rss.xml" class="text-fg-muted hover:text-accent transition-colors no-underline">RSS feed &rarr;</a></li>
						<li><a href="mailto:contact@invokevirtual.org" class="text-fg-muted hover:text-accent transition-colors no-underline">Email directly &rarr;</a></li>
					</ul>
				</div>
			</aside>
		</div>
	</body>
</html>
