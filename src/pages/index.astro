---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	PROJECTS,
	AVATAR_URL,
	GITHUB_DISPLAY,
} from '../consts';

const featuredProjects = PROJECTS.filter((project) => project.featured);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<img
					class="avatar"
					src={AVATAR_URL}
					alt="Pranav Purwar"
					width="100"
					height="100"
				/>
				<h1>Pranav Purwar</h1>
				<p class="handle">@{GITHUB_DISPLAY}</p>
				<p class="bio">
					Systems engineer building developer tools, JVM compilers, and privacy-first Android apps. Founder of Cosmic IDE, aload0, and Bryte-Edu.
				</p>
			</section>

			<section class="projects-section">
				<h2>Projects</h2>
				<div class="project-grid">
					{featuredProjects.map((project) => (
						<ProjectCard {...project} />
					))}
				</div>
				<div class="view-all-container">
					<a href="/projects" class="view-all-link">View all projects &rarr;</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 3rem 1rem;
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 2rem 0 3.5rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 3rem;
	}

	.avatar {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		border: 2px solid var(--border);
		object-fit: cover;
		margin-bottom: 1.25rem;
	}

	h1 {
		font-size: 2.25rem;
		font-weight: 700;
		color: var(--fg);
		margin: 0 0 0.25rem 0;
		letter-spacing: -0.02em;
	}

	.handle {
		font-family: var(--font-mono);
		color: var(--fg-dim);
		font-size: 0.95rem;
		margin: 0 0 1rem 0;
	}

	.bio {
		max-width: 580px;
		color: var(--fg-muted);
		font-size: 1.1rem;
		line-height: 1.6;
		margin: 0;
	}

	.projects-section h2 {
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--fg);
		margin: 0 0 1.5rem 0;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.view-all-container {
		margin-top: 2rem;
		text-align: center;
	}

	.view-all-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--accent);
		font-weight: 500;
		font-size: 0.95rem;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.view-all-link:hover {
		color: var(--accent-hover);
	}

	@media (max-width: 900px) {
		.project-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		main {
			padding: 2rem 1rem;
		}

		.hero {
			padding: 1rem 0 2.5rem;
			margin-bottom: 2rem;
		}

		h1 {
			font-size: 1.85rem;
		}

		.bio {
			font-size: 1rem;
		}

		.project-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
