---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_DISPLAY } from '../consts';
import { getProjectsWithLiveStars, calculateTotalStars } from '../lib/github';

const projects = await getProjectsWithLiveStars();
const featuredProjects = projects.filter((project) => project.featured);
const totalStars = calculateTotalStars(projects);

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = allPosts.slice(0, 4);

const faqItems = [
	{
		question: "What is the primary focus of your open-source work?",
		answer: "I build developer tools, compiler infrastructure (Java/Kotlin), and rootless Linux userlands that run directly on mobile devices without relying on external cloud servers."
	},
	{
		question: "How are these compiler toolchains ported to Android?",
		answer: "I adapt upstream OpenJDK javac and Kotlin compiler toolchains to execute within Android's ART execution environment and PRoot userlands."
	},
	{
		question: "How can other developers get in touch or contribute?",
		answer: "All my repositories are public on GitHub (@PranavPurwar). You can submit issues, open pull requests, or reach out directly at contact@invokevirtual.org."
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="app-container has-widgets">
			<Header />

			<main>
				<!-- Hero Section -->
				<section class="hero-box">
					<span class="mono-subtitle">@{GITHUB_DISPLAY} &bull; SYSTEMS &amp; ANDROID</span>
					<h1 class="hero-title">
						Developer tools, compilers, and Linux environments on mobile.
					</h1>
					<p class="hero-lead">
						I build developer tools, IDEs, and utility for mobile devices. My work centers on Cosmic IDE and ported compiler toolchains to let developers write, compile, and run code locally on Android.
					</p>
					<div class="cta-row">
						<a href="/projects" class="btn btn--primary">View Projects &rarr;</a>
						<a href="https://github.com/PranavPurwar" target="_blank" rel="noopener" class="btn btn--ghost">GitHub ({totalStars.toLocaleString()}+ Stars)</a>
					</div>
				</section>

				<!-- Projects Section -->
				<section class="section-block">
					<div class="section-header">
						<div>
							<span class="mono-subtitle">SOFTWARE</span>
							<h2>Featured Projects</h2>
						</div>
						<a href="/projects" class="section-link">All projects &rarr;</a>
					</div>
					<div class="project-list">
						{featuredProjects.map((project) => (
							<ProjectCard {...project} />
						))}
					</div>
				</section>

				<!-- Writing Feed Section -->
				<section class="section-block">
					<div class="section-header">
						<div>
							<span class="mono-subtitle">PUBLICATIONS</span>
							<h2>Recent Writing</h2>
						</div>
						<a href="/blog" class="section-link">All posts &rarr;</a>
					</div>
					<div class="writing-feed">
						{recentPosts.map((post) => (
							<article class="feed-item">
								<div class="feed-meta">
									<time datetime={post.data.pubDate.toISOString()}>
										<FormattedDate date={post.data.pubDate} />
									</time>
									<span class="meta-sep">&bull;</span>
								</div>
								<h3 class="feed-title">
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h3>
								<p class="feed-desc">{post.data.description}</p>
							</article>
						))}
					</div>
				</section>

				<!-- FAQ Section -->
				<section class="section-block">
					<div class="section-header">
						<div>
							<span class="mono-subtitle">FAQ</span>
							<h2>Frequently Asked</h2>
						</div>
					</div>
					<div class="faq-list">
						{faqItems.map((item) => (
							<details class="faq-item">
								<summary>{item.question}</summary>
								<p>{item.answer}</p>
							</details>
						))}
					</div>
				</section>

				<Footer />
			</main>

			<!-- Right Sidebar: Clean Developer Publication Widgets -->
			<aside class="app-widgets">
				<div class="widget-card">
					<h3 class="widget-title">Latest Articles</h3>
					<ul class="widget-posts">
						{allPosts.slice(0, 3).map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="widget-post-link">
									<span class="widget-post-title">{post.data.title}</span>
									<span class="widget-post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>

				<div class="widget-card">
					<h3 class="widget-title">Top Repositories</h3>
					<ul class="widget-repos">
						{projects.slice(0, 4).map((project) => (
							<li>
								<a
									href={project.github}
									target="_blank"
									rel="noopener noreferrer"
									class="widget-repo-link"
								>
									<span class="widget-repo-name">{project.name}</span>
									<span class="widget-repo-stars" title={`${project.stars.toLocaleString()} stars on GitHub`}>
										<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
											<path
												fill="currentColor"
												d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
											></path>
										</svg>
										<span>{project.stars.toLocaleString()}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>

				<div class="widget-card">
					<h3 class="widget-title">About</h3>
					<p class="widget-bio">
						I'm a systems engineer building developer tools, JVM compilers, and privacy-first software for Android.
					</p>
					<ul class="widget-quick-links">
						<li><a href="https://github.com/PranavPurwar" target="_blank" rel="noopener">GitHub profile &rarr;</a></li>
						<li><a href="/rss.xml">RSS feed &rarr;</a></li>
						<li><a href="mailto:contact@invokevirtual.org">Email directly &rarr;</a></li>
					</ul>
				</div>
			</aside>
		</div>
	</body>
</html>

<style>
	.hero-box {
		padding: 1.5rem 0 2.5rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2.5rem;
	}

	.hero-title {
		font-size: 2.rem;
		font-weight: 800;
		line-height: 1.15;
		margin-bottom: 1rem;
		letter-spacing: -0.035em;
		color: var(--fg);
	}

	.hero-lead {
		font-size: 1.05rem;
		color: var(--fg-muted);
		line-height: 1.65;
		max-width: 640px;
		margin-bottom: 1.75rem;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.section-block {
		margin-bottom: 2.75rem;
	}

	.section-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 1.25rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid var(--border);
	}

	.section-header h2 {
		margin: 0;
	}

	.section-link {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent);
		transition: color 0.15s ease, transform 0.15s ease;
	}
	.section-link:hover {
		color: #ffffff;
		transform: translateX(3px);
	}

	.project-list {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.writing-feed {
		display: flex;
		flex-direction: column;
	}

	.feed-item {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}
	.feed-item:last-child {
		border-bottom: none;
	}

	.feed-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.725rem;
		color: var(--fg-dim);
		margin-bottom: 0.35rem;
	}

	.meta-sep {
		color: var(--border);
	}

	.meta-cat {
		color: var(--fg-muted);
		text-transform: uppercase;
		font-weight: 600;
		letter-spacing: 0.03em;
	}

	.feed-title {
		margin: 0 0 0.35rem 0;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.015em;
	}

	.feed-title a {
		color: var(--fg);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.feed-title a:hover {
		color: #ffffff;
		text-decoration: underline;
	}

	.feed-desc {
		font-size: 0.9rem;
		color: var(--fg-muted);
		margin: 0;
		line-height: 1.55;
	}

	.faq-list p {
		font-size: 0.925rem;
		color: var(--fg-muted);
		margin: 0.25rem 0 1rem;
		line-height: 1.6;
	}

	/* Right-side widget panel (Blogging & Project Publication) */
	.app-widgets {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 2rem 0;
		position: sticky;
		top: 0;
	}

	.widget-card {
		padding: 1.15rem;
		background: var(--bg-surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.widget-title {
		font-family: var(--font-mono);
		font-size: 0.725rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fg-dim);
		margin: 0 0 0.85rem 0;
		padding-bottom: 0.45rem;
		border-bottom: 1px solid var(--border);
	}

	.widget-posts, .widget-repos, .widget-quick-links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.widget-post-link {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		text-decoration: none;
	}

	.widget-post-title {
		font-size: 0.875rem;
		color: #cbd5e1;
		line-height: 1.4;
		font-weight: 500;
		transition: color 0.15s ease;
	}

	.widget-post-link:hover .widget-post-title {
		color: #ffffff;
		text-decoration: underline;
	}

	.widget-post-date {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--fg-dim);
	}

	.widget-repo-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		text-decoration: none;
		gap: 0.5rem;
	}

	.widget-repo-name {
		font-size: 0.875rem;
		color: #cbd5e1;
		font-weight: 500;
		transition: color 0.15s ease;
	}

	.widget-repo-link:hover .widget-repo-name {
		color: #ffffff;
	}

	.widget-repo-stars {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.725rem;
		color: var(--fg-muted);
	}

	.widget-repo-stars svg {
		color: #eab308;
	}

	.widget-bio {
		font-size: 0.85rem;
		color: var(--fg-muted);
		line-height: 1.55;
		margin: 0 0 0.85rem 0;
	}

	.widget-quick-links li a {
		font-size: 0.8rem;
		color: var(--fg-muted);
		font-family: var(--font-mono);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.widget-quick-links li a:hover {
		color: #ffffff;
	}

	@media (max-width: 1023px) {
		.app-widgets {
			display: none;
		}

		.hero-title {
			font-size: 1.95rem;
		}
	}
</style>
